@using MathFirst.Application
@using MathFirst.Application.Gameplay
@using MathFirst.Application.Practice
@using MathFirst.Domain.CyberDefense
@inject ILocalizationService Localizer

<div class="cyber-defense-hud @(EffectiveModel.IsBoss ? "hud-boss-active" : "")" role="region" aria-label='@Localizer["CyberDefense_Title"]'>
    <!-- ENEMY BATTLE SCENE -->
    <section class="enemy-battle-scene @(EffectiveModel.IsBoss ? "scene-boss" : "")"
             aria-label="@OpponentName"
             data-spotlight-id="enemy-hud">
        <!-- Top grouping: Sector, wave or boss label, and the opponent's name -->
        <div class="scene-top-bar">
            <div class="scene-heading-meta">
                <div class="scene-category-tag">
                    <svg class="reticle-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
                        <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5" />
                        <circle cx="8" cy="8" r="2" fill="currentColor" />
                        <line x1="8" y1="0" x2="8" y2="4" stroke="currentColor" stroke-width="1.5" />
                        <line x1="8" y1="12" x2="8" y2="16" stroke="currentColor" stroke-width="1.5" />
                        <line x1="0" y1="8" x2="4" y2="8" stroke="currentColor" stroke-width="1.5" />
                        <line x1="12" y1="8" x2="16" y2="8" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                    <span class="scene-category-text">@Localizer["CyberDefense_Title"]</span>
                    <span class="scene-sector-tag">@Localizer["CyberDefense_SectorDisplay", EffectiveModel.SectorNumber]</span>
                </div>
                <div class="scene-top-actions">
                    <div class="scene-wave-tag @(EffectiveModel.IsBoss ? "wave-boss-active" : "")">
                        @if (EffectiveModel.IsSectorBoss)
                        {
                            <span class="boss-wave-text boss-intel-badge sector-boss-badge">@Localizer["CyberDefense_SectorBossLabel"]</span>
                        }
                        else if (EffectiveModel.IsBoss)
                        {
                            <span class="boss-wave-text boss-intel-badge">@Localizer["CyberDefense_BossLabel"]</span>
                        }
                        else
                        {
                            @Localizer["CyberDefense_WaveDisplay", EffectiveModel.WaveNumber, EffectiveModel.TotalOpponentCount]
                        }
                    </div>
                </div>
            </div>
            <h2 class="scene-enemy-name @(EffectiveModel.IsBoss ? "boss-enemy-name" : "")">@OpponentName</h2>
        </div>

        <!-- Atmospheric Scene Interior -->
        <div class="scene-stage @(EffectiveModel.IsBoss ? "scene-stage-boss" : "")">
            <!-- Atmospheric Cyber Layers -->
            <div class="scene-skyline" aria-hidden="true"></div>
            <div class="scene-grid-floor" aria-hidden="true"></div>
            <div class="scene-particles" aria-hidden="true">
                <span class="particle p1"></span>
                <span class="particle p2"></span>
                <span class="particle p3"></span>
                <span class="particle p4"></span>
            </div>

            <!-- Left: description in the free height above the numeric opponent HP -->
            <div class="scene-intel">
                <div class="scene-enemy-desc-frame">
                    <p class="scene-enemy-desc">@OpponentDescription</p>
                </div>

                <div class="enemy-hp-cluster">
                    <div class="meter-bar enemy-hp-bar @(EffectiveModel.IsBoss ? "boss-hp-bar" : "")"
                         role="progressbar"
                         aria-label='@Localizer["CyberDefense_EnemyHpLabel"]'
                         aria-valuenow="@EffectiveModel.OpponentCurrentHp"
                         aria-valuemin="0"
                         aria-valuetext="@OpponentHpText"
                         aria-valuemax="@EffectiveModel.OpponentMaxHp">
                        <div class="meter-fill hp-fill @(EffectiveModel.IsBoss ? "boss-hp-fill" : "")" style="width: @(EffectiveModel.OpponentHpPercentage)%"></div>
                    </div>
                    <span class="enemy-hp-value @(EffectiveModel.IsBoss ? "boss-hp-value" : "")">@OpponentHpText</span>
                </div>
            </div>

            <!-- Right: opponent artwork in its own clean area -->
            <div class="scene-artwork-wrapper @(EffectiveModel.IsBoss ? "is-boss" : "") @OpponentScaleClass @ArtworkFeedbackClass" @key="@($"opponent-{EffectiveModel.FeedbackRevision}")">
                <img src="@EffectiveModel.OpponentAssetPath"
                     alt="@OpponentName"
                     class="scene-opponent-image @OpponentFeedbackClass" />
                <div class="scene-enemy-floor-glow @(EffectiveModel.IsBoss ? "boss-floor-glow" : "")" aria-hidden="true"></div>
                @if (EffectiveModel.LastFeedback == CyberDefenseFeedbackKind.Hit)
                {
                    <div class="battle-feedback-overlay hit-feedback-overlay" aria-hidden="true">
                        <div class="feedback-badge-group">
                            <span class="battle-feedback-badge badge-hit">@Localizer["CyberDefense_Feedback_Hit"]</span>
                            <span class="damage-number normal-damage">-@EffectiveModel.LastAppliedOpponentDamage HP</span>
                        </div>
                    </div>
                }
                else if (EffectiveModel.LastFeedback == CyberDefenseFeedbackKind.CriticalHit)
                {
                    <div class="battle-feedback-overlay crit-feedback-overlay" aria-hidden="true">
                        <div class="feedback-badge-group">
                            <span class="battle-feedback-badge badge-crit">@Localizer["CyberDefense_Feedback_CriticalHit"]</span>
                            <span class="damage-number crit-damage">-@EffectiveModel.LastAppliedOpponentDamage HP</span>
                        </div>
                    </div>
                }
                else if (EffectiveModel.LastFeedback == CyberDefenseFeedbackKind.Blocked)
                {
                    <div class="battle-feedback-overlay blocked-feedback-overlay" aria-hidden="true">
                        <div class="feedback-badge-group">
                            <span class="battle-feedback-badge badge-blocked">@Localizer["CyberDefense_Feedback_Blocked"]</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- PLAYER HP & TACTICAL INTEGRITY AREA -->
    <section class="player-shield-panel"
             aria-label='@Localizer["CyberDefense_HpDisplay", EffectiveModel.PlayerCurrentHp, EffectiveModel.PlayerMaxHp]'
             data-spotlight-id="system-integrity">
        <!-- Left: player status rows (Issue #136): Level/XP on top, earned shields in the middle, HP at the bottom.
             The rows share one column grid, so the XP, recharge and HP meters start and end together. -->
        <div class="shield-status-column">
            <!-- Persistent player level and XP: authoritative durable progression, never the run's sector. -->
            <div class="player-xp-cluster">
                <svg class="player-status-icon xp-progress-icon" viewBox="0 0 12 12" width="10" height="10" fill="none" aria-hidden="true">
                    <path d="M6 10.5V2M2.5 5.5 6 2l3.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="player-level-label">@Localizer["CyberDefense_PlayerLevelDisplay", PlayerProgress is null ? Localizer["Training_Unavailable"] : PlayerProgress.Level]</span>
                @if (PlayerProgress is { } progress)
                {
                    <div class="meter-bar player-xp-bar"
                         role="progressbar"
                         aria-label='@Localizer["CyberDefense_PlayerLevelAria", progress.Level]'
                         aria-valuemin="0"
                         aria-valuenow="@progress.XpIntoCurrentLevel"
                         aria-valuemax="@progress.XpRequiredForNextLevel"
                         aria-valuetext='@Localizer["CyberDefense_PlayerXpAria", progress.XpIntoCurrentLevel, progress.XpRequiredForNextLevel]'>
                        <div class="meter-fill player-xp-fill" style="width: @(XpPercentage(progress))%"></div>
                    </div>
                    @* The arrow and the level name the row; the localized "x of y XP" stays the meter's accessible value. *@
                    <span class="player-xp-value">@progress.XpIntoCurrentLevel / @progress.XpRequiredForNextLevel</span>
                }
                else
                {
                    <div class="meter-bar player-xp-bar"
                         role="progressbar"
                         aria-label='@Localizer["CyberDefense_PlayerLevelUnavailableAria"]'
                         aria-valuetext='@Localizer["CyberDefense_PlayerLevelUnavailableAria"]'>
                        <div class="meter-fill player-xp-fill" style="width: 0%"></div>
                    </div>
                    <span class="player-xp-value">@Localizer["Training_Unavailable"]</span>
                }
            </div>
            <!-- Reserved even without shields, so a Firewall purchase never moves the math workspace below. -->
            <div class="player-status-heading">
                @if (EffectiveModel.ShieldCapacity > 0)
                {
                    <div class="shield-badges-row"
                         role="meter"
                         aria-label='@Localizer["CyberDefense_ShieldLabel"]'
                         aria-valuemin="0"
                         aria-valuemax="@EffectiveModel.ShieldCapacity"
                         aria-valuenow="@EffectiveModel.ActiveShields"
                         aria-valuetext='@Localizer["CyberDefense_ShieldDisplay", EffectiveModel.ActiveShields, EffectiveModel.ShieldCapacity]'
                         aria-live="polite">
                        <span class="shield-badge @(EffectiveModel.ActiveShields > 0 ? "shield-intact" : "shield-broken")" aria-hidden="true">
                            <svg viewBox="0 0 20 24" width="10" height="12" fill="none">
                                <path class="shield-bg shield-outline" d="M10 2 18 5v6c0 5-4 9-8 11-4-2-8-6-8-11V5Z" />
                                @if (EffectiveModel.ActiveShields > 0)
                                {
                                    <circle class="shield-core" cx="10" cy="11" r="3" />
                                }
                            </svg>
                        </span>
                        <span class="shield-count-text" aria-hidden="true">@EffectiveModel.ActiveShields / @EffectiveModel.ShieldCapacity</span>
                    </div>
                    @if (EffectiveModel.ActiveShields < EffectiveModel.ShieldCapacity)
                    {
                        <!-- Authoritative recharge progress towards the next shield (run state units over the Firewall threshold). -->
                        <div class="meter-bar shield-recharge-bar"
                             role="progressbar"
                             aria-label='@Localizer["CyberDefense_ShieldRechargeLabel"]'
                             aria-valuemin="0"
                             aria-valuemax="@CyberDefenseFirewallPolicy.RechargeThresholdUnits"
                             aria-valuenow="@EffectiveModel.ShieldRechargeUnits"
                             aria-valuetext='@Localizer["CyberDefense_ShieldRechargeDisplay", EffectiveModel.ShieldRechargeUnits, CyberDefenseFirewallPolicy.RechargeThresholdUnits]'>
                            <div class="meter-fill shield-recharge-fill" style="width: @(ShieldRechargePercentage)%"></div>
                        </div>
                        <!-- Recharge units, marked with their own charging icon so they never read as a shield count. -->
                        <span class="shield-recharge-value" aria-hidden="true">
                            <svg class="shield-recharge-icon" viewBox="0 0 12 12" width="9" height="9" fill="none">
                                <path d="M6.8 1 3 6.6h2.8L5.2 11 9 5.4H6.2Z" fill="currentColor" />
                            </svg>
                            @EffectiveModel.ShieldRechargeUnits / @CyberDefenseFirewallPolicy.RechargeThresholdUnits
                        </span>
                    }
                }
            </div>
            <!-- Player HP, bottom left, with a heart. -->
            <div class="player-hp-cluster">
                <svg class="player-status-icon player-hp-icon" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                    <path d="M6 10.6 1.7 6.4A2.6 2.6 0 0 1 6 2.9a2.6 2.6 0 0 1 4.3 3.5Z" fill="currentColor" />
                </svg>
                @* Issue #138: the visible row label; screen readers keep the localized meter name instead. *@
                <span class="player-hp-label" aria-hidden="true">@Localizer["CyberDefense_HpLabel"]</span>
                <div class="meter-bar player-hp-bar"
                     role="progressbar"
                     aria-label='@Localizer["CyberDefense_HpDisplay", EffectiveModel.PlayerCurrentHp, EffectiveModel.PlayerMaxHp]'
                     aria-valuenow="@EffectiveModel.PlayerCurrentHp"
                     aria-valuemin="0"
                     aria-valuemax="@EffectiveModel.PlayerMaxHp">
                    <div class="meter-fill player-hp-fill" style="width: @(EffectiveModel.PlayerHpPercentage)%"></div>
                </div>
                @* The heart and the HP label name the row; the localized "HP: current / max" stays the panel's and the meter's accessible name. *@
                <span class="player-hp-value">@EffectiveModel.PlayerCurrentHp / @EffectiveModel.PlayerMaxHp</span>
            </div>
        </div>

        <!-- Right: Tactical Radar & Telemetry -->
        <div class="shield-telemetry-column">
            @* The Critical Strike radar is shown only once a rank was actually purchased (Issue #134). *@
            @if (IsCriticalStrikeEarned)
            {
                <div class="tactical-radar-widget @RadarFeedbackClass" aria-hidden="true">
                    <svg class="radar-svg" viewBox="0 0 54 54" width="46" height="46" fill="none">
                        <circle cx="27" cy="27" r="25" stroke="currentColor" stroke-width="1" class="radar-ring-outer" />
                        <circle cx="27" cy="27" r="17" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" class="radar-ring-mid" />
                        <circle cx="27" cy="27" r="9" stroke="currentColor" stroke-width="1" class="radar-ring-inner" />
                        <line x1="27" y1="2" x2="27" y2="52" stroke="currentColor" stroke-width="1" class="radar-axis" />
                        <line x1="2" y1="27" x2="52" y2="27" stroke="currentColor" stroke-width="1" class="radar-axis" />
                        @if (CriticalWindowMs > 0 && !RadarTiming.IsExhausted)
                        {
                            <circle @key="RadarSegmentKey"
                                    data-radar-segment="@RadarSegmentKey"
                                    cx="27" cy="27" r="23"
                                    class="radar-timing-arc"
                                    style="--crit-window-duration: @(RadarSegmentTiming.TotalDurationMs)ms; --crit-window-delay: @(RadarSegmentTiming.NegativeDelayMs)ms;@(IsTimingActive ? string.Empty : " animation-play-state: paused;")"
                                    transform="rotate(-90 27 27)" />
                        }
                        <line x1="27" y1="27" x2="48" y2="10" stroke="currentColor" stroke-width="1.5" class="radar-sweep" />
                        <circle cx="38" cy="18" r="2" fill="currentColor" class="radar-blip" />
                    </svg>
                </div>
            }
            <div class="tactical-telemetry-list" aria-hidden="true">
                @if (EffectiveModel.IsSectorBoss)
                {
                    <span class="telemetry-item boss-telemetry"><span class="telemetry-bullet boss-bullet"></span>@Localizer["CyberDefense_SectorBossLabel"]: THREAT HIGH</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Defend"]</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Progress"]</span>
                }
                else if (EffectiveModel.IsBoss)
                {
                    <span class="telemetry-item boss-telemetry"><span class="telemetry-bullet boss-bullet"></span>@Localizer["CyberDefense_BossLabel"]: THREAT HIGH</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Defend"]</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Progress"]</span>
                }
                else
                {
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Solve"]</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Defend"]</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Progress"]</span>
                }
            </div>
        </div>

        <!-- Future Boss Encounter Timer Slot (Structural hook for encounter-wide boss countdown) -->
        <div class="boss-timer-slot" aria-hidden="true"></div>
    </section>
</div>

@code {
    [Parameter]
    public CyberDefenseHudViewModel? ViewModel { get; set; }

    [Parameter]
    public CyberDefenseEncounterState? State { get; set; }

    [Parameter]
    public long CriticalWindowMs { get; set; } = 2500;

    [Parameter]
    public long ActiveElapsedMs { get; set; } = 0;

    [Parameter]
    public string? TaskKey { get; set; }

    /// <summary>
    /// Authoritative purchased Critical Strike rank, or null while it is unknown. The radar is shown only for a
    /// purchased rank (1 or more); showing or hiding it never changes damage, timing or purchase rules.
    /// </summary>
    [Parameter]
    public int? CriticalStrikeRank { get; set; }

    /// <summary>Whether the session's active answer clock is running; while it is not, the radar arc is frozen.</summary>
    [Parameter]
    public bool IsTimingActive { get; set; } = true;

    /// <summary>
    /// Latest committed permanent player progression, or null while no authoritative status is known yet.
    /// The component never derives level or XP itself.
    /// </summary>
    [Parameter]
    public PlayerLevelProgress? PlayerProgress { get; set; }

    // Radar animation segment: one continuous stretch of the same task with the clock either running or frozen.
    // The arc's CSS animation is bound once per segment, at the active elapsed time when the segment began; later
    // rerenders (for example typing a digit) leave it untouched. Rebinding the negative animation-delay of a running
    // CSS animation would shift its start and visibly jump the arc ahead by the elapsed time.
    private long _radarSegment;
    private string? _radarSegmentTaskKey;
    private bool _radarSegmentTimingActive;
    private long _radarSegmentWindowMs;
    private long _radarSegmentElapsedMs;
    private bool _radarSegmentEarned;

    protected override void OnParametersSet()
    {
        if (_radarSegment == 0 ||
            !string.Equals(TaskKey, _radarSegmentTaskKey, StringComparison.Ordinal) ||
            IsTimingActive != _radarSegmentTimingActive ||
            CriticalWindowMs != _radarSegmentWindowMs ||
            IsCriticalStrikeEarned != _radarSegmentEarned ||
            ActiveElapsedMs < _radarSegmentElapsedMs)
        {
            _radarSegment++;
            _radarSegmentTaskKey = TaskKey;
            _radarSegmentTimingActive = IsTimingActive;
            _radarSegmentWindowMs = CriticalWindowMs;
            _radarSegmentEarned = IsCriticalStrikeEarned;
            _radarSegmentElapsedMs = ActiveElapsedMs;
        }
    }

    private static string XpPercentage(PlayerLevelProgress progress) =>
        (Math.Clamp(progress.ProgressRatio, 0d, 1d) * 100d).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private CyberDefenseHudViewModel EffectiveModel =>
        ViewModel ?? (State != null ? CyberDefenseHudViewModel.FromEncounterState(State) : CyberDefenseHudViewModel.Initial());

    private bool IsCriticalStrikeEarned => CriticalStrikeRank is >= 1;

    private CyberDefenseRadarTimingState RadarTiming =>
        CyberDefenseRadarTimingPolicy.CalculateTimingState(CriticalWindowMs, ActiveElapsedMs);

    private CyberDefenseRadarTimingState RadarSegmentTiming =>
        CyberDefenseRadarTimingPolicy.CalculateTimingState(CriticalWindowMs, _radarSegmentElapsedMs);

    private string RadarSegmentKey => $"{TaskKey ?? "default"}:{_radarSegment}";

    private string OpponentName => Localizer[EffectiveModel.OpponentNameKey];

    private string OpponentDescription => Localizer[EffectiveModel.OpponentDescKey];

    private string OpponentHpText => Localizer["CyberDefense_HpDisplay", EffectiveModel.OpponentCurrentHp, EffectiveModel.OpponentMaxHp];

    private string ShieldRechargePercentage =>
        (Math.Clamp((double)EffectiveModel.ShieldRechargeUnits / CyberDefenseFirewallPolicy.RechargeThresholdUnits, 0d, 1d) * 100d)
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // The ViewModel projection is authoritative; the policy fallback only covers models built without a scale class.
    private string OpponentScaleClass => !string.IsNullOrEmpty(EffectiveModel.OpponentScaleClass)
        ? EffectiveModel.OpponentScaleClass
        : CyberDefenseOpponentScalePolicy.GetScaleClass(EffectiveModel.SectorNumber, EffectiveModel.OpponentIndex, EffectiveModel.NormalOpponentCount, EffectiveModel.IsSectorBoss, EffectiveModel.IsBoss);

    private string ArtworkFeedbackClass => EffectiveModel.LastFeedback switch
    {
        CyberDefenseFeedbackKind.CriticalHit => "feedback-crit-active",
        CyberDefenseFeedbackKind.Hit => "feedback-hit-active",
        _ => string.Empty
    };

    private string OpponentFeedbackClass => EffectiveModel.LastFeedback switch
    {
        CyberDefenseFeedbackKind.CriticalHit => "opponent-crit-recoil",
        CyberDefenseFeedbackKind.Hit => "opponent-hit-recoil",
        _ => string.Empty
    };

    private string RadarFeedbackClass => EffectiveModel.LastFeedback switch
    {
        CyberDefenseFeedbackKind.CriticalHit => "radar-crit-burst",
        CyberDefenseFeedbackKind.Hit => "radar-hit-burst",
        _ => string.Empty
    };
}
