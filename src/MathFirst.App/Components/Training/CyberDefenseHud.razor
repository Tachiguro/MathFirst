@using MathFirst.Application
@using MathFirst.Application.Practice
@inject ILocalizationService Localizer

<div class="cyber-defense-hud @(State.IsBoss ? "hud-boss-active" : "")" role="region" aria-label='@Localizer["CyberDefense_Title"]'>
    <!-- ENEMY BATTLE SCENE -->
    <section class="enemy-battle-scene @(State.IsBoss ? "scene-boss" : "")" aria-label="@OpponentName">
        <!-- Tech Top Header Bar -->
        <div class="scene-top-bar">
            <div class="scene-category-tag">
                <svg class="reticle-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true">
                    <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5" />
                    <circle cx="8" cy="8" r="2" fill="currentColor" />
                    <line x1="8" y1="0" x2="8" y2="4" stroke="currentColor" stroke-width="1.5" />
                    <line x1="8" y1="12" x2="8" y2="16" stroke="currentColor" stroke-width="1.5" />
                    <line x1="0" y1="8" x2="4" y2="8" stroke="currentColor" stroke-width="1.5" />
                    <line x1="12" y1="8" x2="16" y2="8" stroke="currentColor" stroke-width="1.5" />
                </svg>
                <span class="scene-category-text">@Localizer["CyberDefense_Title"]</span>
                <span class="scene-sector-tag">@Localizer["CyberDefense_SectorDisplay", State.SectorNumber]</span>
            </div>
            <div class="scene-wave-tag @(State.IsBoss ? "wave-boss-active" : "")">
                @if (State.IsSectorBoss)
                {
                    <span class="boss-wave-text">@Localizer["CyberDefense_SectorBossLabel"]</span>
                }
                else if (State.IsBoss)
                {
                    <span class="boss-wave-text">@Localizer["CyberDefense_BossLabel"]</span>
                }
                else
                {
                    @Localizer["CyberDefense_WaveDisplay", State.EnemyIndex + 1, CyberDefenseEncounterState.PrototypeEnemyCount]
                }
            </div>
        </div>

        <!-- Atmospheric Scene Interior -->
        <div class="scene-stage @(State.IsBoss ? "scene-stage-boss" : "")">
            <!-- Atmospheric Cyber Layers -->
            <div class="scene-skyline" aria-hidden="true"></div>
            <div class="scene-grid-floor" aria-hidden="true"></div>
            <div class="scene-particles" aria-hidden="true">
                <span class="particle p1"></span>
                <span class="particle p2"></span>
                <span class="particle p3"></span>
                <span class="particle p4"></span>
            </div>

            <!-- Left: Opponent Intel -->
            <div class="scene-intel">
                <div class="scene-enemy-header">
                    @if (State.IsSectorBoss)
                    {
                        <span class="boss-intel-badge sector-boss-badge" aria-label="@Localizer["CyberDefense_SectorBossLabel"]">@Localizer["CyberDefense_SectorBossLabel"]</span>
                    }
                    else if (State.IsBoss)
                    {
                        <span class="boss-intel-badge" aria-label="@Localizer["CyberDefense_BossLabel"]">@Localizer["CyberDefense_BossLabel"]</span>
                    }
                    <h2 class="scene-enemy-name @(State.IsBoss ? "boss-enemy-name" : "")">@OpponentName</h2>
                </div>
                
                <div class="enemy-hp-cluster">
                    <div class="meter-bar enemy-hp-bar @(State.IsBoss ? "boss-hp-bar" : "")"
                         role="progressbar"
                         aria-label='@Localizer["CyberDefense_EnemyHpLabel"]'
                         aria-valuenow="@State.EnemyHitPoints"
                         aria-valuemin="0"
                         aria-valuemax="@State.EnemyMaxHitPoints">
                        <div class="meter-fill hp-fill @(State.IsBoss ? "boss-hp-fill" : "")" style="width: @(EnemyHpPercentage)%"></div>
                    </div>
                    <span class="enemy-hp-value @(State.IsBoss ? "boss-hp-value" : "")">@(EnemyHpPercentage)% HP</span>
                </div>

                <p class="scene-enemy-desc">@OpponentDescription</p>
            </div>

            <!-- Right: Large Opponent Artwork -->
            <div class="scene-artwork-wrapper @(State.IsBoss ? "is-boss" : "") @ArtworkFeedbackClass" @key="@($"opponent-{State.FeedbackRevision}")">
                <img src="@OpponentAssetPath"
                     alt="@OpponentName"
                     class="scene-opponent-image @OpponentFeedbackClass" />
                <div class="scene-enemy-floor-glow @(State.IsBoss ? "boss-floor-glow" : "")" aria-hidden="true"></div>
                @if (State.LastFeedback == CyberDefenseFeedbackKind.CriticalHit)
                {
                    <div class="battle-feedback-overlay hit-feedback-overlay crit-feedback-overlay" aria-hidden="true">
                        <div class="feedback-badge-group">
                            <span class="battle-feedback-badge badge-crit">@Localizer["CyberDefense_Feedback_CriticalHit"]</span>
                            <span class="damage-number crit-damage">-@State.LastDamageDealt HP</span>
                        </div>
                    </div>
                }
                else if (State.LastFeedback == CyberDefenseFeedbackKind.Hit)
                {
                    <div class="battle-feedback-overlay hit-feedback-overlay" aria-hidden="true">
                        <div class="feedback-badge-group">
                            <span class="battle-feedback-badge badge-hit">@Localizer["CyberDefense_Feedback_Hit"]</span>
                            <span class="damage-number normal-damage">-@State.LastDamageDealt HP</span>
                        </div>
                    </div>
                }
                else if (State.LastFeedback == CyberDefenseFeedbackKind.Blocked)
                {
                    <div class="battle-feedback-overlay blocked-feedback-overlay" aria-hidden="true">
                        <span class="battle-feedback-badge badge-blocked">@Localizer["CyberDefense_Feedback_Blocked"]</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- PLAYER SHIELD & TACTICAL INTEGRITY AREA -->
    <section class="player-shield-panel" aria-label='@Localizer["CyberDefense_YourShield"]'>
        <!-- Left: Shield Segment Status -->
        <div class="shield-status-column">
            <span class="shield-section-title">@Localizer["CyberDefense_YourShield"]</span>
            <div class="shield-badges-row @ShieldFeedbackClass"
                 @key="@($"shields-{State.FeedbackRevision}")"
                 role="group"
                 aria-label='@Localizer["CyberDefense_ShieldDisplay", State.ShieldSegments, CyberDefenseEncounterState.PrototypeShieldSegments]'>
                @for (var i = 0; i < CyberDefenseEncounterState.PrototypeShieldSegments; i++)
                {
                    var isIntact = i < State.ShieldSegments;
                    <div class="shield-badge @(isIntact ? "shield-intact" : "shield-broken")"
                         aria-hidden="true">
                        <svg class="shield-icon" viewBox="0 0 24 28" width="22" height="26" fill="none">
                            <path d="M12 2 L22 6 L22 15 C22 21 12 26 12 26 C12 26 2 21 2 15 L2 6 Z"
                                  class="shield-bg" />
                            <path d="M12 2 L22 6 L22 15 C22 21 12 26 12 26 C12 26 2 21 2 15 L2 6 Z"
                                  class="shield-outline" />
                            @if (isIntact)
                            {
                                <path d="M12 6 L18 9 L18 14 C18 18 12 22 12 22 C12 22 6 18 6 14 L6 9 Z"
                                      class="shield-core" />
                            }
                        </svg>
                    </div>
                }
                <div class="shield-count-group">
                    <span class="shield-fraction-number">@State.ShieldSegments / @CyberDefenseEncounterState.PrototypeShieldSegments</span>
                    <span class="shield-sublabel-text">@Localizer["CyberDefense_Integrity"]</span>
                </div>
            </div>
        </div>

        <!-- Right: Tactical Radar & Telemetry -->
        <div class="shield-telemetry-column">
            <div class="tactical-radar-widget @RadarFeedbackClass" aria-hidden="true">
                <svg class="radar-svg" viewBox="0 0 54 54" width="46" height="46" fill="none">
                    <circle cx="27" cy="27" r="25" stroke="currentColor" stroke-width="1" class="radar-ring-outer" />
                    <circle cx="27" cy="27" r="17" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" class="radar-ring-mid" />
                    <circle cx="27" cy="27" r="9" stroke="currentColor" stroke-width="1" class="radar-ring-inner" />
                    <line x1="27" y1="2" x2="27" y2="52" stroke="currentColor" stroke-width="1" class="radar-axis" />
                    <line x1="2" y1="27" x2="52" y2="27" stroke="currentColor" stroke-width="1" class="radar-axis" />
                    @if (CriticalWindowMs > 0)
                    {
                        <circle @key="@(TaskKey ?? "default")"
                                cx="27" cy="27" r="23"
                                class="radar-timing-arc"
                                style="--crit-window-duration: @(CriticalWindowMs)ms;"
                                transform="rotate(-90 27 27)" />
                    }
                    <line x1="27" y1="27" x2="48" y2="10" stroke="currentColor" stroke-width="1.5" class="radar-sweep" />
                    <circle cx="38" cy="18" r="2" fill="currentColor" class="radar-blip" />
                </svg>
            </div>
            <div class="tactical-telemetry-list" aria-hidden="true">
                @if (State.IsSectorBoss)
                {
                    <span class="telemetry-item boss-telemetry"><span class="telemetry-bullet boss-bullet"></span>@Localizer["CyberDefense_SectorBossLabel"]: THREAT HIGH</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Defend"]</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Progress"]</span>
                }
                else if (State.IsBoss)
                {
                    <span class="telemetry-item boss-telemetry"><span class="telemetry-bullet boss-bullet"></span>@Localizer["CyberDefense_BossLabel"]: THREAT HIGH</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Defend"]</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Progress"]</span>
                }
                else
                {
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Solve"]</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Defend"]</span>
                    <span class="telemetry-item"><span class="telemetry-bullet"></span>@Localizer["CyberDefense_Telemetry_Progress"]</span>
                }
            </div>
        </div>

        <!-- Future Boss Encounter Timer Slot (Structural hook for encounter-wide boss countdown) -->
        <div class="boss-timer-slot" aria-hidden="true"></div>
    </section>
</div>

@code {
    [Parameter, EditorRequired]
    public CyberDefenseEncounterState State { get; set; } = default!;

    [Parameter]
    public long CriticalWindowMs { get; set; } = 2500;

    [Parameter]
    public string? TaskKey { get; set; }

    private string OpponentName => Localizer[State.CurrentEnemy.NameKey];

    private string OpponentDescription => Localizer[State.CurrentEnemy.DescKey];

    private string OpponentAssetPath => State.CurrentEnemy.AssetPath switch
    {
        "images/cyber-defense/glitch-drone.svg" => "images/cyber-defense/glitch-drone.svg",
        "images/cyber-defense/virus-core.svg" => "images/cyber-defense/virus-core.svg",
        "images/cyber-defense/crystal-malware.svg" => "images/cyber-defense/crystal-malware.svg",
        var path => path
    };

    private int EnemyHpPercentage =>
        (int)Math.Round((double)Math.Clamp(State.EnemyHitPoints, 0, State.EnemyMaxHitPoints)
            / State.EnemyMaxHitPoints * 100);

    private int ShieldPercentage =>
        (int)Math.Round((double)Math.Clamp(State.ShieldSegments, 0, CyberDefenseEncounterState.PrototypeShieldSegments)
            / CyberDefenseEncounterState.PrototypeShieldSegments * 100);

    private string ArtworkFeedbackClass => State.LastFeedback switch
    {
        CyberDefenseFeedbackKind.CriticalHit => "feedback-crit-active",
        CyberDefenseFeedbackKind.Hit => "feedback-hit-active",
        CyberDefenseFeedbackKind.Blocked => "feedback-blocked-active",
        _ => string.Empty
    };

    private string OpponentFeedbackClass => State.LastFeedback switch
    {
        CyberDefenseFeedbackKind.CriticalHit => "opponent-crit-recoil",
        CyberDefenseFeedbackKind.Hit => "opponent-hit-recoil",
        CyberDefenseFeedbackKind.Blocked => "opponent-block-deflect",
        _ => string.Empty
    };

    private string ShieldFeedbackClass => State.LastFeedback switch
    {
        CyberDefenseFeedbackKind.Blocked => "shield-damage-pulse",
        _ => string.Empty
    };

    private string RadarFeedbackClass => State.LastFeedback switch
    {
        CyberDefenseFeedbackKind.CriticalHit => "radar-crit-burst",
        CyberDefenseFeedbackKind.Hit => "radar-hit-burst",
        _ => string.Empty
    };
}
