    private void ApplyPurchaseResult(UpgradePurchaseResult result, SkillFeedbackTarget target)
    {
        switch (result.Status)
        {
            case UpgradePurchaseStatus.Success:
                _feedbackKind = FeedbackKind.Success;
                _feedbackMessage = target switch
                {
                    SkillFeedbackTarget.Firewall => EffectiveLocalizer["UpgradeTerminal_Feedback_FirewallSuccess"],
                    SkillFeedbackTarget.CriticalStrike => EffectiveLocalizer["UpgradeTerminal_Feedback_CriticalStrikeSuccess"],
                    SkillFeedbackTarget.Overdrive => EffectiveLocalizer["UpgradeTerminal_Feedback_OverdriveSuccess"],
                    _ => EffectiveLocalizer["UpgradeTerminal_Feedback_Success"]
                };
                break;

            case UpgradePurchaseStatus.LockedLevel:
                _feedbackKind = FeedbackKind.Warning;
                _feedbackMessage = target switch
                {
                    SkillFeedbackTarget.CriticalStrike => EffectiveLocalizer["UpgradeTerminal_Feedback_CriticalStrikeLockedLevel"],
                    SkillFeedbackTarget.Overdrive => EffectiveLocalizer["UpgradeTerminal_Feedback_OverdriveLockedLevel"],
                    _ => EffectiveLocalizer["UpgradeTerminal_Feedback_LockedLevel"]
                };
                break;

            case UpgradePurchaseStatus.InsufficientSkillPoints:
                _feedbackKind = FeedbackKind.Warning;
                _feedbackMessage = EffectiveLocalizer["UpgradeTerminal_Feedback_InsufficientSkillPoints"];
                break;

            case UpgradePurchaseStatus.StaleRank:
                _feedbackKind = FeedbackKind.Warning;
                _feedbackMessage = target switch
                {
                    SkillFeedbackTarget.Firewall => EffectiveLocalizer["UpgradeTerminal_Feedback_FirewallStaleRank"],
                    SkillFeedbackTarget.CriticalStrike => EffectiveLocalizer["UpgradeTerminal_Feedback_CriticalStrikeStaleRank"],
                    SkillFeedbackTarget.Overdrive => EffectiveLocalizer["UpgradeTerminal_Feedback_OverdriveStaleRank"],
                    _ => EffectiveLocalizer["UpgradeTerminal_Feedback_StaleRank"]
                };
                break;

            case UpgradePurchaseStatus.StaleResetEpoch:
                _feedbackKind = FeedbackKind.Warning;
                _feedbackMessage = EffectiveLocalizer["UpgradeTerminal_Feedback_StaleResetEpoch"];
                break;

            case UpgradePurchaseStatus.MaxRankReached:
                _feedbackKind = FeedbackKind.Info;
                _feedbackMessage = target switch
                {
                    SkillFeedbackTarget.Firewall => EffectiveLocalizer["UpgradeTerminal_Feedback_FirewallMaxRank"],
                    SkillFeedbackTarget.CriticalStrike => EffectiveLocalizer["UpgradeTerminal_Feedback_CriticalStrikeMaxRank"],
                    SkillFeedbackTarget.Overdrive => EffectiveLocalizer["UpgradeTerminal_Feedback_OverdriveMaxRank"],
                    _ => EffectiveLocalizer["UpgradeTerminal_Feedback_MaxRankReached"]
                };
                break;

            case UpgradePurchaseStatus.Busy:
                _feedbackKind = FeedbackKind.Warning;
                _feedbackMessage = EffectiveLocalizer["UpgradeTerminal_Feedback_Busy"];
                break;

            case UpgradePurchaseStatus.Disposed:
                _feedbackKind = FeedbackKind.Error;
                _feedbackMessage = EffectiveLocalizer["UpgradeTerminal_Feedback_Disposed"];
                break;

            case UpgradePurchaseStatus.Cancelled:
                _feedbackKind = FeedbackKind.Info;
                _feedbackMessage = EffectiveLocalizer["UpgradeTerminal_Feedback_Cancelled"];
                break;

            case UpgradePurchaseStatus.Error:
            default:
                _feedbackKind = FeedbackKind.Error;
                _feedbackMessage = EffectiveLocalizer["UpgradeTerminal_Feedback_Error"];
                break;
        }
    }

    private async Task HandleCloseClick()
    {
        if (_isDisposed) return;

        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    public void Dispose()
    {
        if (_isDisposed) return;
        _isDisposed = true;
        UnsubscribeFromViewModel();
    }
}
