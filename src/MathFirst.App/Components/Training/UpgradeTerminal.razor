@using System.Threading
@using System.Threading.Tasks
@using MathFirst.Application
@using MathFirst.Application.Gameplay
@implements IDisposable
@inject ILocalizationService InjectedLocalizer

<section class="practice-overlay upgrade-terminal-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="upgrade-terminal-title"
         aria-describedby="upgrade-terminal-subtitle">
    <div class="practice-overlay-content upgrade-terminal-content">
        <header class="upgrade-terminal-header">
            <h2 id="upgrade-terminal-title">@EffectiveLocalizer["UpgradeTerminal_Title"]</h2>
            <p id="upgrade-terminal-subtitle" class="upgrade-terminal-subtitle">@EffectiveLocalizer["UpgradeTerminal_Subtitle"]</p>
        </header>

        <!-- Player Meta: Level & Available Skill Points -->
        <div class="upgrade-meta-bar" role="region" aria-label="@EffectiveLocalizer["UpgradeTerminal_PlayerStatusAriaLabel"]">
            <div class="meta-stat-pill">
                <span class="meta-stat-label">@EffectiveLocalizer["UpgradeTerminal_LevelLabel"]</span>
                <span class="meta-stat-value">@EffectivePlayerLevel</span>
            </div>
            <div class="meta-stat-pill meta-stat-sp">
                <span class="meta-stat-label">@EffectiveLocalizer["UpgradeTerminal_SkillPointsLabel"]</span>
                <span class="meta-stat-value">@EffectiveAvailableSp</span>
            </div>
        </div>

        <!-- Upgrade Cards List -->
        <div class="upgrade-cards-container" role="list">
            <article class="upgrade-card attack-upgrade-card" role="listitem" aria-labelledby="attack-upgrade-title">
                <div class="upgrade-card-header">
                    <div class="upgrade-icon-slot" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                        </svg>
                    </div>
                    <div class="upgrade-title-group">
                        <h3 id="attack-upgrade-title" class="upgrade-card-title">@EffectiveLocalizer["UpgradeTerminal_AttackTitle"]</h3>
                        <span class="upgrade-rank-badge">@EffectiveLocalizer["UpgradeTerminal_CurrentRank", EffectiveCurrentRank]</span>
                    </div>
                </div>

                <p class="upgrade-card-desc">@EffectiveLocalizer["UpgradeTerminal_AttackDescription"]</p>

                <div class="upgrade-stats-grid">
                    <div class="stat-cell current-stat">
                        <span class="stat-name">@EffectiveLocalizer["UpgradeTerminal_CurrentDamage", EffectiveCurrentDamage]</span>
                    </div>
                    <div class="stat-cell next-stat">
                        @if (IsMaxRank)
                        {
                            <span class="stat-max">@EffectiveLocalizer["UpgradeTerminal_MaxRank"]</span>
                        }
                        else
                        {
                            <span class="stat-next">@EffectiveLocalizer["UpgradeTerminal_NextRankDamage", EffectiveNextDamage ?? 0]</span>
                        }
                    </div>
                </div>

                <div class="upgrade-cost-row">
                    @if (IsMaxRank)
                    {
                        <span class="cost-badge cost-max">@EffectiveLocalizer["UpgradeTerminal_MaxRank"]</span>
                    }
                    else
                    {
                        <span class="cost-badge @(CanAfford ? "cost-affordable" : "cost-insufficient")">
                            @EffectiveLocalizer["UpgradeTerminal_Cost", EffectiveNextCost ?? 0]
                        </span>
                    }
                </div>
            </article>

            <article class="upgrade-card firewall-upgrade-card" role="listitem" aria-labelledby="firewall-upgrade-title">
                <div class="upgrade-card-header">
                    <div class="upgrade-icon-slot firewall-icon-slot" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        </svg>
                    </div>
                    <div class="upgrade-title-group">
                        <h3 id="firewall-upgrade-title" class="upgrade-card-title">@EffectiveLocalizer["UpgradeTerminal_FirewallTitle"]</h3>
                        <span class="upgrade-rank-badge">@EffectiveLocalizer["UpgradeTerminal_PermanentRank", EffectiveCurrentFirewallRank]</span>
                    </div>
                </div>

                <p class="upgrade-card-desc">@EffectiveLocalizer["UpgradeTerminal_FirewallDescription"]</p>
                <p class="upgrade-card-notice">@EffectiveLocalizer["UpgradeTerminal_FirewallActivationNotice"]</p>

                <div class="upgrade-stats-grid">
                    <div class="stat-cell current-stat">
                        <span class="stat-name">@EffectiveLocalizer["UpgradeTerminal_CurrentCapacity", EffectiveCurrentPermanentCapacity]</span>
                    </div>
                    <div class="stat-cell next-stat">
                        @if (IsFirewallMaxRank)
                        {
                            <span class="stat-max">@EffectiveLocalizer["UpgradeTerminal_MaxRank"]</span>
                        }
                        else
                        {
                            <span class="stat-next">@EffectiveLocalizer["UpgradeTerminal_NextCapacity", EffectiveNextPermanentCapacity ?? 0]</span>
                        }
                    </div>
                </div>

                <div class="upgrade-cost-row">
                    @if (IsFirewallMaxRank)
                    {
                        <span class="cost-badge cost-max">@EffectiveLocalizer["UpgradeTerminal_MaxRank"]</span>
                    }
                    else if (!IsFirewallLevelUnlocked)
                    {
                        <span class="cost-badge cost-locked">
                            @EffectiveLocalizer["UpgradeTerminal_RequiredLevel", EffectiveNextFirewallRequiredLevel ?? 0]
                        </span>
                    }
                    else
                    {
                        <span class="cost-badge @(HasSufficientFirewallSp ? "cost-affordable" : "cost-insufficient")">
                            @EffectiveLocalizer["UpgradeTerminal_Cost", EffectiveNextFirewallCost ?? 0]
                        </span>
                    }
                </div>
            </article>

            <article class="upgrade-card critical-strike-upgrade-card" role="listitem" aria-labelledby="critical-strike-upgrade-title">
                <div class="upgrade-card-header">
                    <div class="upgrade-icon-slot critical-strike-icon-slot" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="22" y1="12" x2="18" y2="12" />
                            <line x1="6" y1="12" x2="2" y2="12" />
                            <line x1="12" y1="6" x2="12" y2="2" />
                            <line x1="12" y1="22" x2="12" y2="18" />
                        </svg>
                    </div>
                    <div class="upgrade-title-group">
                        <h3 id="critical-strike-upgrade-title" class="upgrade-card-title">@EffectiveLocalizer["UpgradeTerminal_CriticalStrikeTitle"]</h3>
                        <span class="upgrade-rank-badge">@EffectiveLocalizer["UpgradeTerminal_CurrentRank", EffectiveCurrentCriticalStrikeRank]</span>
                    </div>
                </div>

                <p class="upgrade-card-desc">@EffectiveLocalizer["UpgradeTerminal_CriticalStrikeDescription"]</p>

                <div class="upgrade-stats-grid">
                    <div class="stat-cell current-stat">
                        <span class="stat-name">@CurrentCriticalStrikeEffectText</span>
                    </div>
                    <div class="stat-cell next-stat">
                        @if (IsCriticalStrikeMaxRank)
                        {
                            <span class="stat-max">@EffectiveLocalizer["UpgradeTerminal_MaxRank"]</span>
                        }
                        else
                        {
                            <span class="stat-next">@EffectiveLocalizer["UpgradeTerminal_NextRank", EffectiveNextCriticalStrikeRank ?? 0] — @NextCriticalStrikeEffectText</span>
                        }
                    </div>
                </div>

                <div class="upgrade-cost-row">
                    @if (IsCriticalStrikeMaxRank)
                    {
                        <span class="cost-badge cost-max">@EffectiveLocalizer["UpgradeTerminal_MaxRank"]</span>
                    }
                    else
                    {
                        <span class="cost-badge @(IsCriticalStrikeLevelUnlocked ? "cost-affordable" : "cost-locked")">
                            @EffectiveLocalizer["UpgradeTerminal_RequiredLevel", EffectiveNextCriticalStrikeRequiredLevel ?? 0]
                        </span>
                        <span class="cost-badge @(HasSufficientCriticalStrikeSp ? "cost-affordable" : "cost-insufficient")">
                            @EffectiveLocalizer["UpgradeTerminal_Cost", EffectiveNextCriticalStrikeCost ?? 0]
                        </span>
                    }
                </div>
            </article>

            <article class="upgrade-card overdrive-upgrade-card" role="listitem" aria-labelledby="overdrive-upgrade-title">
                <div class="upgrade-card-header">
                    <div class="upgrade-icon-slot overdrive-icon-slot" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="13 17 18 12 13 7" />
                            <polyline points="6 17 11 12 6 7" />
                        </svg>
                    </div>
                    <div class="upgrade-title-group">
                        <h3 id="overdrive-upgrade-title" class="upgrade-card-title">@EffectiveLocalizer["UpgradeTerminal_OverdriveTitle"]</h3>
                        <span class="upgrade-rank-badge">@EffectiveLocalizer["UpgradeTerminal_CurrentRank", EffectiveCurrentOverdriveRank]</span>
                    </div>
                </div>

                <p class="upgrade-card-desc">@EffectiveLocalizer["UpgradeTerminal_OverdriveDescription"]</p>
                <p class="upgrade-card-notice">@EffectiveLocalizer["UpgradeTerminal_OverdriveNotice"]</p>

                <div class="upgrade-stats-grid">
                    <div class="stat-cell current-stat">
                        <span class="stat-name">@CurrentOverdriveEffectText</span>
                    </div>
                    <div class="stat-cell next-stat">
                        @if (IsOverdriveMaxRank)
                        {
                            <span class="stat-max">@EffectiveLocalizer["UpgradeTerminal_MaxRank"]</span>
                        }
                        else
                        {
                            <span class="stat-next">@EffectiveLocalizer["UpgradeTerminal_NextRank", EffectiveNextOverdriveRank ?? 0] — @NextOverdriveEffectText</span>
                        }
                    </div>
                </div>

                <div class="upgrade-cost-row">
                    @if (IsOverdriveMaxRank)
                    {
                        <span class="cost-badge cost-max">@EffectiveLocalizer["UpgradeTerminal_MaxRank"]</span>
                    }
                    else
                    {
                        <span class="cost-badge @(IsOverdriveLevelUnlocked ? "cost-affordable" : "cost-locked")">
                            @EffectiveLocalizer["UpgradeTerminal_RequiredLevel", EffectiveNextOverdriveRequiredLevel ?? 0]
                        </span>
                        <span class="cost-badge @(HasSufficientOverdriveSp ? "cost-affordable" : "cost-insufficient")">
                            @EffectiveLocalizer["UpgradeTerminal_Cost", EffectiveNextOverdriveCost ?? 0]
                        </span>
                    }
                </div>
            </article>
        </div>

        <!-- Accessible Live Announcement Region for Purchase Feedback -->
        <div class="upgrade-terminal-feedback @FeedbackCssClass"
             role="status"
             aria-live="polite"
             aria-atomic="true">
            @if (!string.IsNullOrEmpty(_feedbackMessage))
            {
                <span class="feedback-text">@_feedbackMessage</span>
            }
        </div>

        <!-- Dialog Actions: Purchase & Close -->
        <div class="upgrade-terminal-actions">
            <button type="button"
                    @ref="_purchaseButton"
                    class="button button-primary practice-overlay-action upgrade-purchase-btn attack-purchase-btn"
                    disabled="@IsPurchaseDisabled"
                    aria-disabled="@IsPurchaseDisabled"
                    aria-label="@PurchaseButtonAriaLabel"
                    @onclick="HandlePurchaseClick">
                @PurchaseButtonText
            </button>
            <button type="button"
                    @ref="_firewallPurchaseButton"
                    class="button button-primary practice-overlay-action upgrade-purchase-btn firewall-purchase-btn"
                    disabled="@IsFirewallPurchaseDisabled"
                    aria-disabled="@IsFirewallPurchaseDisabled"
                    aria-label="@FirewallPurchaseButtonAriaLabel"
                    @onclick="HandleFirewallPurchaseClick">
                @FirewallPurchaseButtonText
            </button>
            <button type="button"
                    @ref="_criticalStrikePurchaseButton"
                    class="button button-primary practice-overlay-action upgrade-purchase-btn critical-strike-purchase-btn"
                    disabled="@IsCriticalStrikePurchaseDisabled"
                    aria-disabled="@IsCriticalStrikePurchaseDisabled"
                    aria-label="@CriticalStrikePurchaseButtonAriaLabel"
                    @onclick="HandleCriticalStrikePurchaseClick">
                @CriticalStrikePurchaseButtonText
            </button>
            <button type="button"
                    @ref="_overdrivePurchaseButton"
                    class="button button-primary practice-overlay-action upgrade-purchase-btn overdrive-purchase-btn"
                    disabled="@IsOverdrivePurchaseDisabled"
                    aria-disabled="@IsOverdrivePurchaseDisabled"
                    aria-label="@OverdrivePurchaseButtonAriaLabel"
                    @onclick="HandleOverdrivePurchaseClick">
                @OverdrivePurchaseButtonText
            </button>
            <button type="button"
                    @ref="_closeButton"
                    class="button button-secondary practice-overlay-action upgrade-close-btn"
                    aria-label="@EffectiveLocalizer["UpgradeTerminal_CloseAction"]"
                    @onclick="HandleCloseClick">
                @EffectiveLocalizer["UpgradeTerminal_CloseAction"]
            </button>
        </div>
    </div>
</section>

@code {
    private enum FeedbackKind
    {
        None,
        Success,
        Warning,
        Error,
        Info
    }

    private enum SkillFeedbackTarget
    {
        Attack,
        Firewall,
        CriticalStrike,
        Overdrive
    }

    [Parameter]
    public UpgradeTerminalViewModel? ViewModel { get; set; }

    [Parameter]
    public ILocalizationService? Localizer { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private ElementReference _purchaseButton;
    private ElementReference _firewallPurchaseButton;
    private ElementReference _criticalStrikePurchaseButton;
    private ElementReference _overdrivePurchaseButton;
    private ElementReference _closeButton;
    private UpgradeTerminalViewModel? _subscribedViewModel;
    private bool _isProcessingPurchase;
    private bool _isProcessingFirewallPurchase;
    private bool _isProcessingCriticalStrikePurchase;
    private bool _isProcessingOverdrivePurchase;
    private bool _isDisposed;
    private bool _initialFocusSet;
    private string? _feedbackMessage;
    private FeedbackKind _feedbackKind = FeedbackKind.None;

    private ILocalizationService EffectiveLocalizer => Localizer ?? InjectedLocalizer;

    private int EffectivePlayerLevel => ViewModel?.PlayerLevel ?? 1;
    private int EffectiveAvailableSp => ViewModel?.AvailableSkillPoints ?? 0;
    private int EffectiveCurrentRank => ViewModel?.CurrentAttackRank ?? 0;
    private int EffectiveCurrentDamage => ViewModel?.CurrentBaseDamage ?? 1;
    private int? EffectiveNextDamage => ViewModel?.NextBaseDamage;
    private int? EffectiveNextCost => ViewModel?.NextRankCost;
    private bool IsMaxRank => ViewModel?.IsMaxRank ?? false;
    private bool CanAfford => ViewModel?.CanAfford ?? false;

    private int EffectiveCurrentFirewallRank => ViewModel?.CurrentFirewallRank ?? 0;
    private int EffectiveCurrentPermanentCapacity => ViewModel?.CurrentPermanentCapacity ?? 0;
    private int? EffectiveNextPermanentCapacity => ViewModel?.NextPermanentCapacity;
    private int? EffectiveNextFirewallCost => ViewModel?.NextFirewallCost;
    private int? EffectiveNextFirewallRequiredLevel => ViewModel?.NextRequiredLevel;
    private bool IsFirewallMaxRank => ViewModel?.IsFirewallMaxRank ?? false;
    private bool IsFirewallLevelUnlocked => ViewModel?.IsFirewallLevelUnlocked ?? false;
    private bool HasSufficientFirewallSp => ViewModel?.HasSufficientFirewallSkillPoints ?? false;
    private bool CanPurchaseFirewall => ViewModel?.CanPurchaseFirewall ?? false;

    private int EffectiveCurrentCriticalStrikeRank => ViewModel?.CurrentCriticalStrikeRank ?? 0;
    private int? EffectiveNextCriticalStrikeRank => ViewModel?.NextCriticalStrikeRank;
    private int? EffectiveNextCriticalStrikeRequiredLevel => ViewModel?.NextCriticalStrikeRequiredLevel;
    private int? EffectiveNextCriticalStrikeCost => ViewModel?.NextCriticalStrikeCost;
    private bool IsCriticalStrikeMaxRank => ViewModel?.IsCriticalStrikeMaxRank ?? false;
    private bool IsCriticalStrikeLevelUnlocked => ViewModel?.IsCriticalStrikeLevelUnlocked ?? false;
    private bool HasSufficientCriticalStrikeSp => ViewModel?.HasSufficientCriticalStrikeSkillPoints ?? false;
    private bool CanPurchaseCriticalStrike => ViewModel?.CanPurchaseCriticalStrike ?? false;

    private int EffectiveCurrentOverdriveRank => ViewModel?.CurrentOverdriveRank ?? 0;
    private int? EffectiveNextOverdriveRank => ViewModel?.NextOverdriveRank;
    private int? EffectiveNextOverdriveRequiredLevel => ViewModel?.NextOverdriveRequiredLevel;
    private int? EffectiveNextOverdriveCost => ViewModel?.NextOverdriveCost;
    private bool IsOverdriveMaxRank => ViewModel?.IsOverdriveMaxRank ?? false;
    private bool IsOverdriveLevelUnlocked => ViewModel?.IsOverdriveLevelUnlocked ?? false;
    private bool HasSufficientOverdriveSp => ViewModel?.HasSufficientOverdriveSkillPoints ?? false;
    private bool CanPurchaseOverdrive => ViewModel?.CanPurchaseOverdrive ?? false;

    private string CurrentCriticalStrikeEffectText => EffectiveCurrentCriticalStrikeRank switch
    {
        1 => EffectiveLocalizer["UpgradeTerminal_CriticalStrikeEffect_Rank1"],
        2 => EffectiveLocalizer["UpgradeTerminal_CriticalStrikeEffect_Rank2"],
        _ => EffectiveLocalizer["UpgradeTerminal_CriticalStrikeEffect_Rank0"]
    };

    private string NextCriticalStrikeEffectText => EffectiveNextCriticalStrikeRank switch
    {
        1 => EffectiveLocalizer["UpgradeTerminal_CriticalStrikeEffect_Rank1"],
        2 => EffectiveLocalizer["UpgradeTerminal_CriticalStrikeEffect_Rank2"],
        _ => EffectiveLocalizer["UpgradeTerminal_MaxRank"]
    };

    private string CurrentOverdriveEffectText => EffectiveCurrentOverdriveRank switch
    {
        1 => EffectiveLocalizer["UpgradeTerminal_OverdriveEffect_Rank1"],
        2 => EffectiveLocalizer["UpgradeTerminal_OverdriveEffect_Rank2"],
        _ => EffectiveLocalizer["UpgradeTerminal_OverdriveEffect_Rank0"]
    };

    private string NextOverdriveEffectText => EffectiveNextOverdriveRank switch
    {
        1 => EffectiveLocalizer["UpgradeTerminal_OverdriveEffect_Rank1"],
        2 => EffectiveLocalizer["UpgradeTerminal_OverdriveEffect_Rank2"],
        _ => EffectiveLocalizer["UpgradeTerminal_MaxRank"]
    };

    public bool IsPurchaseDisabled =>
        _isDisposed ||
        _isProcessingPurchase ||
        _isProcessingFirewallPurchase ||
        _isProcessingCriticalStrikePurchase ||
        _isProcessingOverdrivePurchase ||
        ViewModel == null ||
        ViewModel.IsDisposed ||
        ViewModel.IsBusy ||
        ViewModel.IsMaxRank ||
        !ViewModel.HasSufficientSkillPoints ||
        !ViewModel.CanPurchase;

    public bool IsFirewallPurchaseDisabled =>
        _isDisposed ||
        _isProcessingPurchase ||
        _isProcessingFirewallPurchase ||
        _isProcessingCriticalStrikePurchase ||
        _isProcessingOverdrivePurchase ||
        ViewModel == null ||
        ViewModel.IsDisposed ||
        ViewModel.IsBusy ||
        ViewModel.IsFirewallMaxRank ||
        !ViewModel.IsFirewallLevelUnlocked ||
        !ViewModel.HasSufficientFirewallSkillPoints ||
        !ViewModel.CanPurchaseFirewall;

    public bool IsCriticalStrikePurchaseDisabled =>
        _isDisposed ||
        _isProcessingPurchase ||
        _isProcessingFirewallPurchase ||
        _isProcessingCriticalStrikePurchase ||
        _isProcessingOverdrivePurchase ||
        ViewModel == null ||
        ViewModel.IsDisposed ||
        ViewModel.IsBusy ||
        ViewModel.IsCriticalStrikeMaxRank ||
        !ViewModel.IsCriticalStrikeLevelUnlocked ||
        !ViewModel.HasSufficientCriticalStrikeSkillPoints ||
        !ViewModel.CanPurchaseCriticalStrike;

    public bool IsOverdrivePurchaseDisabled =>
        _isDisposed ||
        _isProcessingPurchase ||
        _isProcessingFirewallPurchase ||
        _isProcessingCriticalStrikePurchase ||
        _isProcessingOverdrivePurchase ||
        ViewModel == null ||
        ViewModel.IsDisposed ||
        ViewModel.IsBusy ||
        ViewModel.IsOverdriveMaxRank ||
        !ViewModel.IsOverdriveLevelUnlocked ||
        !ViewModel.HasSufficientOverdriveSkillPoints ||
        !ViewModel.CanPurchaseOverdrive;

    private string PurchaseButtonText
    {
        get
        {
            if (ViewModel?.IsBusy == true || _isProcessingPurchase)
            {
                return EffectiveLocalizer["UpgradeTerminal_Purchasing"];
            }
            if (IsMaxRank)
            {
                return EffectiveLocalizer["UpgradeTerminal_MaxRank"];
            }
            return EffectiveLocalizer["UpgradeTerminal_UpgradeAction"];
        }
    }

    private string FirewallPurchaseButtonText
    {
        get
        {
            if (ViewModel?.IsBusy == true || _isProcessingFirewallPurchase)
            {
                return EffectiveLocalizer["UpgradeTerminal_Purchasing"];
            }
            if (IsFirewallMaxRank)
            {
                return EffectiveLocalizer["UpgradeTerminal_MaxRank"];
            }
            if (!IsFirewallLevelUnlocked)
            {
                return EffectiveLocalizer["UpgradeTerminal_LevelLocked", EffectiveNextFirewallRequiredLevel ?? 0];
            }
            return EffectiveLocalizer["UpgradeTerminal_UpgradeFirewallAction"];
        }
    }

    private string CriticalStrikePurchaseButtonText
    {
        get
        {
            if (ViewModel?.IsBusy == true || _isProcessingCriticalStrikePurchase)
            {
                return EffectiveLocalizer["UpgradeTerminal_Purchasing"];
            }
            if (IsCriticalStrikeMaxRank)
            {
                return EffectiveLocalizer["UpgradeTerminal_MaxRank"];
            }
            if (!IsCriticalStrikeLevelUnlocked)
            {
                return EffectiveLocalizer["UpgradeTerminal_LevelLocked", EffectiveNextCriticalStrikeRequiredLevel ?? 0];
            }
            return EffectiveLocalizer["UpgradeTerminal_UpgradeCriticalStrikeAction"];
        }
    }

    private string OverdrivePurchaseButtonText
    {
        get
        {
            if (ViewModel?.IsBusy == true || _isProcessingOverdrivePurchase)
            {
                return EffectiveLocalizer["UpgradeTerminal_Purchasing"];
            }
            if (IsOverdriveMaxRank)
            {
                return EffectiveLocalizer["UpgradeTerminal_MaxRank"];
            }
            if (!IsOverdriveLevelUnlocked)
            {
                return EffectiveLocalizer["UpgradeTerminal_LevelLocked", EffectiveNextOverdriveRequiredLevel ?? 0];
            }
            return EffectiveLocalizer["UpgradeTerminal_UpgradeOverdriveAction"];
        }
    }

    private string PurchaseButtonAriaLabel
    {
        get
        {
            if (IsMaxRank)
            {
                return $"{EffectiveLocalizer["UpgradeTerminal_AttackTitle"]}: {EffectiveLocalizer["UpgradeTerminal_MaxRank"]}";
            }
            return $"{EffectiveLocalizer["UpgradeTerminal_UpgradeAction"]}: {EffectiveLocalizer["UpgradeTerminal_Cost", EffectiveNextCost ?? 0]}";
        }
    }

    private string FirewallPurchaseButtonAriaLabel
    {
        get
        {
            if (IsFirewallMaxRank)
            {
                return $"{EffectiveLocalizer["UpgradeTerminal_FirewallTitle"]}: {EffectiveLocalizer["UpgradeTerminal_MaxRank"]}";
            }
            if (!IsFirewallLevelUnlocked)
            {
                return $"{EffectiveLocalizer["UpgradeTerminal_UpgradeFirewallAction"]}: {EffectiveLocalizer["UpgradeTerminal_RequiredLevel", EffectiveNextFirewallRequiredLevel ?? 0]}";
            }
            return $"{EffectiveLocalizer["UpgradeTerminal_UpgradeFirewallAction"]}: {EffectiveLocalizer["UpgradeTerminal_Cost", EffectiveNextFirewallCost ?? 0]}";
        }
    }

    private string CriticalStrikePurchaseButtonAriaLabel
    {
        get
        {
            if (IsCriticalStrikeMaxRank)
            {
                return EffectiveLocalizer[
                    "UpgradeTerminal_CriticalStrikePurchaseAriaLabel",
                    EffectiveLocalizer["UpgradeTerminal_CriticalStrikeTitle"],
                    EffectiveLocalizer["UpgradeTerminal_MaxRank"]];
            }
            if (!IsCriticalStrikeLevelUnlocked)
            {
                return EffectiveLocalizer[
                    "UpgradeTerminal_CriticalStrikePurchaseAriaLabel",
                    EffectiveLocalizer["UpgradeTerminal_UpgradeCriticalStrikeAction"],
                    EffectiveLocalizer["UpgradeTerminal_RequiredLevel", EffectiveNextCriticalStrikeRequiredLevel ?? 0]];
            }
            return EffectiveLocalizer[
                "UpgradeTerminal_CriticalStrikePurchaseAriaLabel",
                EffectiveLocalizer["UpgradeTerminal_UpgradeCriticalStrikeAction"],
                EffectiveLocalizer["UpgradeTerminal_Cost", EffectiveNextCriticalStrikeCost ?? 0]];
        }
    }

    private string OverdrivePurchaseButtonAriaLabel
    {
        get
        {
            if (IsOverdriveMaxRank)
            {
                return EffectiveLocalizer[
                    "UpgradeTerminal_OverdrivePurchaseAriaLabel",
                    EffectiveLocalizer["UpgradeTerminal_OverdriveTitle"],
                    EffectiveLocalizer["UpgradeTerminal_MaxRank"]];
            }
            if (!IsOverdriveLevelUnlocked)
            {
                return EffectiveLocalizer[
                    "UpgradeTerminal_OverdrivePurchaseAriaLabel",
                    EffectiveLocalizer["UpgradeTerminal_UpgradeOverdriveAction"],
                    EffectiveLocalizer["UpgradeTerminal_RequiredLevel", EffectiveNextOverdriveRequiredLevel ?? 0]];
            }
            return EffectiveLocalizer[
                "UpgradeTerminal_OverdrivePurchaseAriaLabel",
                EffectiveLocalizer["UpgradeTerminal_UpgradeOverdriveAction"],
                EffectiveLocalizer["UpgradeTerminal_Cost", EffectiveNextOverdriveCost ?? 0]];
        }
    }

    private string FeedbackCssClass => _feedbackKind switch
    {
        FeedbackKind.Success => "feedback-success",
        FeedbackKind.Warning => "feedback-warning",
        FeedbackKind.Error => "feedback-error",
        FeedbackKind.Info => "feedback-info",
        _ => "feedback-empty"
    };

    protected override void OnInitialized()
    {
        SubscribeToViewModel();
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_subscribedViewModel, ViewModel))
        {
            UnsubscribeFromViewModel();
            SubscribeToViewModel();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialFocusSet)
        {
            _initialFocusSet = true;
            try
            {
                if (ViewModel?.CanPurchase == true)
                {
                    await _purchaseButton.FocusAsync();
                }
                else if (ViewModel?.CanPurchaseFirewall == true)
                {
                    await _firewallPurchaseButton.FocusAsync();
                }
                else if (ViewModel?.CanPurchaseCriticalStrike == true)
                {
                    await _criticalStrikePurchaseButton.FocusAsync();
                }
                else if (ViewModel?.CanPurchaseOverdrive == true)
                {
                    await _overdrivePurchaseButton.FocusAsync();
                }
                else
                {
                    await _closeButton.FocusAsync();
                }
            }
            catch
            {
                // Headless test harnesses or platforms without active focus targets catch safely.
            }
        }
    }

    private void SubscribeToViewModel()
    {
        if (ViewModel != null && !_isDisposed)
        {
            _subscribedViewModel = ViewModel;
            _subscribedViewModel.StateChanged += OnViewModelStateChanged;
        }
    }

    private void UnsubscribeFromViewModel()
    {
        if (_subscribedViewModel != null)
        {
            _subscribedViewModel.StateChanged -= OnViewModelStateChanged;
            _subscribedViewModel = null;
        }
    }

    private void OnViewModelStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            if (_isDisposed) return;
            StateHasChanged();
        });
    }

    private async Task HandlePurchaseClick()
    {
        if (IsPurchaseDisabled || ViewModel == null)
        {
            return;
        }

        _isProcessingPurchase = true;
        _feedbackMessage = null;
        _feedbackKind = FeedbackKind.None;

        try
        {
            var result = await ViewModel.PurchaseUpgradeAsync();
            ApplyPurchaseResult(result, SkillFeedbackTarget.Attack);
        }
        catch (Exception)
        {
            _feedbackKind = FeedbackKind.Error;
            _feedbackMessage = EffectiveLocalizer["UpgradeTerminal_Feedback_Error"];
        }
        finally
        {
            _isProcessingPurchase = false;
            await InvokeAsync(StateHasChanged);
        }
    }

