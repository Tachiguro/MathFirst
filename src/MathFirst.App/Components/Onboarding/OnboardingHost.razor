@implements IDisposable
@using MathFirst.App.Services
@using MathFirst.Application
@using MathFirst.Domain
@inject ILocalizationService Localizer
@inject IThemeService ThemeService
@inject IPreferenceStore PreferenceStore

<div class="onboarding-host">
    <main class="onboarding-main">
        <div class="onboarding-container">
            <header class="onboarding-header">
                <h1 class="onboarding-title">@Localizer["Onboarding_WelcomeTitle"]</h1>
                <p class="onboarding-concept">@Localizer["Onboarding_Concept"]</p>
            </header>

            <div class="onboarding-card">
                @if (_currentStep == 1)
                {
                    <section class="onboarding-step">
                        <h2 class="onboarding-section-title">@Localizer["Onboarding_StepLanguage_Title"]</h2>
                        <p class="setting-help">@Localizer["Onboarding_StepLanguage_Desc"]</p>

                        <div class="choice-grid choice-grid-two">
                            <button type="button"
                                    class="choice-button @(_selectedLanguage == "system" ? "active" : null)"
                                    @onclick='() => SelectLanguage("system")'>
                                @Localizer["Settings_UILanguageSystem"]
                            </button>
                            <button type="button"
                                    class="choice-button @(_selectedLanguage == "en" ? "active" : null)"
                                    @onclick='() => SelectLanguage("en")'>
                                @Localizer["Settings_English"]
                            </button>
                            <button type="button"
                                    class="choice-button @(_selectedLanguage == "de" ? "active" : null)"
                                    @onclick='() => SelectLanguage("de")'>
                                @Localizer["Settings_German"]
                            </button>
                            <button type="button"
                                    class="choice-button @(_selectedLanguage == "ru" ? "active" : null)"
                                    @onclick='() => SelectLanguage("ru")'>
                                @Localizer["Settings_Russian"]
                            </button>
                        </div>

                        <div class="onboarding-actions">
                            <button type="button" class="button button-primary" @onclick="() => _currentStep = 2">
                                @Localizer["Common_Continue"]
                            </button>
                        </div>
                    </section>
                }
                else if (_currentStep == 2)
                {
                    <section class="onboarding-step">
                        <h2 class="onboarding-section-title">@Localizer["Onboarding_StepTheme_Title"]</h2>
                        <p class="setting-help">@Localizer["Onboarding_StepTheme_Desc"]</p>

                        <div class="choice-grid choice-grid-three">
                            <button type="button"
                                    class="choice-button @(_selectedTheme == ThemePreference.System ? "active" : null)"
                                    @onclick="() => SelectTheme(ThemePreference.System)">
                                @Localizer["Settings_AppearanceSystem"]
                            </button>
                            <button type="button"
                                    class="choice-button @(_selectedTheme == ThemePreference.Light ? "active" : null)"
                                    @onclick="() => SelectTheme(ThemePreference.Light)">
                                @Localizer["Settings_AppearanceLight"]
                            </button>
                            <button type="button"
                                    class="choice-button @(_selectedTheme == ThemePreference.Dark ? "active" : null)"
                                    @onclick="() => SelectTheme(ThemePreference.Dark)">
                                @Localizer["Settings_AppearanceDark"]
                            </button>
                        </div>

                        <div class="onboarding-actions">
                            <button type="button" class="button button-secondary" @onclick="() => _currentStep = 1">
                                @Localizer["Common_Back"]
                            </button>
                            <button type="button" class="button button-primary" @onclick="() => _currentStep = 3">
                                @Localizer["Common_Continue"]
                            </button>
                        </div>
                    </section>
                }
                else
                {
                    <section class="onboarding-step">
                        <h2 class="onboarding-section-title">@Localizer["Onboarding_StepReady_Title"]</h2>
                        <p class="setting-help">@Localizer["Onboarding_StepReady_Desc"]</p>

                        <div class="onboarding-actions">
                            <button type="button" class="button button-secondary" @onclick="() => _currentStep = 2">
                                @Localizer["Common_Back"]
                            </button>
                            <button type="button" class="button button-primary" @onclick="CompleteOnboardingAsync">
                                @Localizer["Common_Start"]
                            </button>
                        </div>
                    </section>
                }
            </div>
        </div>
    </main>
</div>

@code {
    [Parameter] public EventCallback OnCompleted { get; set; }

    private int _currentStep = 1;
    private string _selectedLanguage = "system";
    private ThemePreference _selectedTheme = ThemePreference.System;

    protected override void OnInitialized()
    {
        _selectedLanguage = PreferenceStore.GetLanguagePreference();
        _selectedTheme = PreferenceStore.GetThemePreference();

        Localizer.UiLanguageChanged += OnLanguageChanged;
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    public void Dispose()
    {
        Localizer.UiLanguageChanged -= OnLanguageChanged;
        ThemeService.ThemeChanged -= OnThemeChanged;
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnThemeChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void SelectLanguage(string lang)
    {
        _selectedLanguage = lang;
        Localizer.ApplyPreviewLanguage(lang);
    }

    private void SelectTheme(ThemePreference theme)
    {
        _selectedTheme = theme;
        ThemeService.ApplyPreviewPreference(theme);
    }

    private async Task CompleteOnboardingAsync()
    {
        PreferenceStore.SetLanguagePreference(_selectedLanguage);
        PreferenceStore.SetThemePreference(_selectedTheme);
        PreferenceStore.SetOnboardingCompleted(true);

        Localizer.ApplyLanguagePreference(_selectedLanguage);
        ThemeService.SetPreference(_selectedTheme);

        if (OnCompleted.HasDelegate)
        {
            await OnCompleted.InvokeAsync();
        }
    }
}
