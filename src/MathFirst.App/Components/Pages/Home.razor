@page "/"
@implements IDisposable
@using MathFirst.Application
@using MathFirst.Application.Copy
@using MathFirst.Application.Diagnostics
@using MathFirst.Domain
@using MathFirst.Domain.Curriculum
@inject ILocalizationService Localizer
@inject TrainingSession Session
@inject PracticeGateCopyState PracticeGateCopyState
@inject IPreferenceStore PreferenceStore
@inject IJSRuntime JSRuntime

<div class="training-host" @onkeydown="HandleGlobalKeyDown" tabindex="0">
    <div class="mathfirst-container">
        <header class="mathfirst-header">
            <div class="mathfirst-title-group">
                <h1 class="mathfirst-title">@Localizer["App_Title"]</h1>
                @if (Session.IsInitialized && Session.CurrentFact is not null)
                {
                    <span class="mathfirst-op-badge">@Localizer[$"Operation_{Session.CurrentFact.Operation}"]</span>
                }
            </div>
            <div class="practice-header-actions">
                @if (CanPausePractice)
                {
                    <button type="button"
                            class="button button-danger pause-practice-btn"
                            title='@Localizer["Training_Pause"]'
                            aria-label='@Localizer["Training_Pause"]'
                            @onclick="PausePractice">
                        <span class="pause-icon" aria-hidden="true">
                            <span class="pause-icon-bar"></span>
                            <span class="pause-icon-bar"></span>
                        </span>
                    </button>
                }
                <a href="settings" class="button button-secondary settings-nav-btn" title='@Localizer["Settings_Title"]'>
                    @Localizer["Settings_Title"]
                </a>
            </div>
        </header>

        @if (!Session.IsInitialized || Session.CurrentFact is null)
        {
            <main class="training-card">
                <div class="score-display">@Localizer["Training_Loading"]</div>
            </main>
        }
        else
        {
            <main class="training-card">
                @if (Session.PracticeGate != PracticeGateState.Running)
                {
                    <section class="practice-overlay practice-gate-overlay"
                             role="dialog"
                             aria-modal="true"
                             aria-labelledby="practice-gate-title">
                        <div class="practice-overlay-content">
                            <h2 id="practice-gate-title">@PracticeGateTitle</h2>
                            <button type="button"
                                    @ref="_primaryOverlayButton"
                                    class="button button-primary practice-overlay-action"
                                    @onclick="StartOrResumePractice">
                                @PracticeGateAction
                            </button>
                        </div>
                    </section>
                }
                else if (Session.InteractionState == SessionInteractionState.PersistenceFailure)
                {
                    <section class="practice-overlay persistence-error-dialog"
                             role="dialog"
                             aria-modal="true"
                             aria-labelledby="persistence-error-title">
                        <div class="practice-overlay-content">
                            <h2 id="persistence-error-title">@Localizer["Training_PersistenceFailureTitle"]</h2>
                            <button type="button"
                                    @ref="_primaryOverlayButton"
                                    class="button button-primary practice-overlay-action"
                                    disabled="@_isSubmitting"
                                    @onclick="RecoverFromPersistenceFailureAsync">
                                @Localizer["Training_Retry"]
                            </button>
                        </div>
                    </section>
                }
                else if (Session.InteractionState == SessionInteractionState.TeachingIntervention)
                {
                    <section class="practice-overlay teaching-dialog"
                             role="dialog"
                             aria-modal="true"
                             aria-labelledby="teaching-dialog-title">
                        <div class="practice-overlay-content">
                            <h2 id="teaching-dialog-title">@Localizer["Training_TeachingTitle"]</h2>
                            <p class="teaching-explanation">@Localizer["Training_TeachingExplanation"]</p>
                            <p class="teaching-equation" aria-label="@Session.CurrentFact.EquationText">
                                <span>@Session.CurrentFact.LeftOperand</span>
                                <span>@Session.CurrentFact.DisplaySymbol</span>
                                <span>@Session.CurrentFact.RightOperand</span>
                                <span>=</span>
                                <span>@Session.CurrentFact.CorrectResult</span>
                            </p>
                            <button type="button"
                                    @ref="_primaryOverlayButton"
                                    class="button button-primary practice-overlay-action"
                                    @onclick="Advance">
                                @Localizer["Common_Continue"] (Enter)
                            </button>
                        </div>
                    </section>
                }
                else if (Session.InteractionState == SessionInteractionState.SessionCheckIn && Session.PendingCheckIn is not null)
                {
                    <section class="practice-overlay checkin-dialog"
                             role="dialog"
                             aria-modal="true"
                             aria-labelledby="checkin-dialog-title">
                        <div class="practice-overlay-content">
                            <h2 id="checkin-dialog-title">@Localizer["Training_CheckInTitle"]</h2>
                            <div class="checkin-stats">
                                <p class="checkin-stat">
                                    @Localizer["Training_CheckInCorrect", Session.PendingCheckIn.CorrectCount, Session.PendingCheckIn.TotalCount]
                                </p>
                                <p class="checkin-stat">
                                    @Localizer["Training_CheckInSpeed", GetCheckInLatencyDisplay(Session.PendingCheckIn.MedianCorrectLatencyMs)]
                                </p>
                            </div>
                            <div class="checkin-actions">
                                <button type="button"
                                        @ref="_primaryOverlayButton"
                                        class="button button-primary practice-overlay-action"
                                        @onclick="KeepGoing">
                                    @Localizer["Training_KeepGoing"] (Enter)
                                </button>
                                <button type="button"
                                        class="button button-secondary practice-overlay-action"
                                        @onclick="TakeBreak">
                                    @Localizer["Training_TakeBreak"]
                                </button>
                            </div>
                        </div>
                    </section>
                }
                else if (IsAwaitingAcknowledgement && Session.LastEvaluation is not null)
                {
                    <section class="practice-overlay feedback-dialog @(Session.InteractionState == SessionInteractionState.TimeoutFeedback ? "feedback-timeout" : "feedback-incorrect")"
                             role="dialog"
                             aria-modal="true"
                             aria-labelledby="feedback-dialog-title">
                        <div class="practice-overlay-content">
                            <p class="feedback-expression">
                                <span>@Session.CurrentFact.LeftOperand</span>
                                <span>@Session.CurrentFact.DisplaySymbol</span>
                                <span>@Session.CurrentFact.RightOperand</span>
                                <span>=</span>
                                <span>?</span>
                            </p>
                            <h2 id="feedback-dialog-title">
                                @(Session.InteractionState == SessionInteractionState.TimeoutFeedback
                                    ? Localizer["Training_TimeExpired"]
                                    : Localizer["Training_IncorrectTitle"])
                            </h2>
                            @if (Session.InteractionState == SessionInteractionState.IncorrectFeedback)
                            {
                                <p class="feedback-user-answer">@Localizer["Training_YourAnswer", SubmittedAnswerDisplay]</p>
                            }
                            <p class="feedback-correct-answer">@Localizer["Training_CorrectAnswer", Session.LastEvaluation.CorrectAnswer]</p>
                            <button type="button"
                                    @ref="_primaryOverlayButton"
                                    class="button button-danger practice-overlay-action"
                                    @onclick="Advance">
                                @Localizer["Common_Continue"] (Enter)
                            </button>
                        </div>
                    </section>
                }
                else
                {
                    <div class="training-top-region">
                        <div class="training-meta-row">
                            <div class="operation-progress-hud" role="group" aria-label="@Localizer["Diagnostics_Group_Learning"]">
                                @foreach (var progress in OperationProgress)
                                {
                                    var operationName = Localizer[$"Operation_{progress.Operation}"];
                                    <span class="operation-progress-entry"
                                          aria-label="@(progress.PresentationStage is int stage
                                              ? Localizer["Training_OperationProgressStage", operationName, stage]
                                              : Localizer["Training_OperationProgressUnavailable", operationName])">
                                        <span class="operation-progress-symbol" aria-hidden="true">@GetOperationSymbol(progress.Operation)</span>
                                        <span class="operation-progress-stage">@(progress.PresentationStage?.ToString() ?? "—")</span>
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="timer-container">
                            <div class="timer-bar-track"
                                 role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="@Session.CurrentFactDeadlineSeconds"
                                 aria-valuenow="@_remainingSecondsDouble.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"
                                 aria-label="@Localizer["Training_TimerAriaLabel", (int)Session.CurrentFactDeadlineSeconds]">
                                <div class="timer-bar-fill"
                                     style="transform: scaleX(@_timerFraction.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)); background-color: @_timerColor;">
                                </div>
                                <span class="timer-bar-text" aria-hidden="true">@_timerDisplayText</span>
                            </div>
                        </div>
                    </div>

                    <div class="practice-layout">
                        <div class="practice-interaction-column">
                            <div class="practice-middle-region">
                                <div class="expression-row">
                                    <span class="expression-problem">
                                        <span class="operand">@Session.CurrentFact.LeftOperand</span>
                                        <span class="operator">@Session.CurrentFact.DisplaySymbol</span>
                                        <span class="operand">@Session.CurrentFact.RightOperand</span>
                                        <span class="equals">=</span>
                                    </span>
                                    <input @key="_inputRenderVersion"
                                           @ref="_inputElement"
                                           type="text"
                                           inputmode="@AnswerInputMode"
                                           virtualkeyboardpolicy="@AnswerVirtualKeyboardPolicy"
                                           pattern="(?:0|[1-9][0-9]*)?(?:[.,][0-9]*)?"
                                           maxlength="@NumericAnswerInputPolicy.MaximumLength"
                                           autocomplete="off"
                                           autocapitalize="off"
                                           spellcheck="false"
                                           enterkeyhint="done"
                                           class="answer-input"
                                           value="@_answerInput"
                                           @oninput="HandleAnswerInput"
                                           disabled="@_isSubmitting"
                                           aria-label="@Localizer["Training_AnswerInputAriaLabel"]" />
                                </div>

                                @if (!string.IsNullOrEmpty(_validationError))
                                {
                                    <div class="validation-message" role="alert">@_validationError</div>
                                }
                            </div>
                        </div>

                        <div class="numeric-keypad"
                             role="group"
                             aria-label="@Localizer["Keypad_NumberKeypad"]">
                            @foreach (var key in NumericKeypadLayoutPolicy.GetKeys(_keypadLayout, DecimalSeparator))
                            {
                                var isBackspace = key == "backspace";
                                <button type="button"
                                        class="numeric-keypad-button @(isBackspace ? "numeric-keypad-backspace" : null)"
                                        disabled="@_isSubmitting"
                                        aria-label="@(isBackspace ? Localizer["Keypad_Backspace"] : key)"
                                        @onclick="() => HandleKeypadKeyAsync(key)">
                                    @(isBackspace ? "⌫" : key)
                                </button>
                            }
                        </div>
                    </div>
                }
            </main>
        }
    </div>
</div>

@code {
    private string _answerInput = string.Empty;
    private string? _validationError;
    private string? _submittedAnswerDisplay;
    private NumericKeypadLayout _keypadLayout = NumericKeypadLayout.Numpad;
    private int _inputRenderVersion;
    private int _guardedInputRenderVersion = -1;
    private bool _isSubmitting;
    private ElementReference _inputElement;
    private ElementReference _primaryOverlayButton;
    private bool _shouldFocusInput = true;
    private bool _shouldFocusPrimaryOverlay;
    private readonly ArithmeticCurriculum _curriculum = new();
    private IReadOnlyList<OperationProgressDiagnostics> _operationProgress = [];
    private long _operationProgressLearnerStateGeneration = long.MinValue;
    private long _operationProgressPracticePosition = long.MinValue;

    private CancellationTokenSource? _timerCts;
    private double _timerFraction = 1.0;
    private double _remainingSecondsDouble = 30.0;
    private string _timerDisplayText = "30.000 s";
    private string _timerColor = "hsl(135, 72%, 42%)";

    protected override async Task OnInitializedAsync()
    {
        Localizer.UiLanguageChanged += OnLanguageChanged;
        Session.AppForegroundStateChanged += OnAppForegroundChanged;
        _keypadLayout = PreferenceStore.GetNumericKeypadLayout();

        if (!Session.IsInitialized)
        {
            await Session.InitializeAsync(startTiming: false);
            Session.ShowInitialReadyGate();
        }

        Session.SetPracticeSurfaceActive(true);
        SyncStateWithSession();
    }

    private void SyncStateWithSession()
    {
        if (Session.InteractionState == SessionInteractionState.AwaitingAnswer)
        {
            if (Session.PracticeGate == PracticeGateState.Running)
            {
                _shouldFocusInput = true;
                _shouldFocusPrimaryOverlay = false;
                if (Session.IsTimingActive)
                {
                    StartTimer();
                }
            }
            else
            {
                _shouldFocusInput = false;
                _shouldFocusPrimaryOverlay = true;
                StopTimer();
            }
        }
        else if (Session.InteractionState == SessionInteractionState.CorrectFeedback)
        {
            _shouldFocusInput = false;
            if (Session.LastEvaluation?.SubmittedNumericAnswer is decimal submittedAnswer)
            {
                _answerInput = NumericAnswerInputPolicy.Format(submittedAnswer, DecimalSeparator);
                _submittedAnswerDisplay = _answerInput;
            }
            StopTimer();
        }
        else if (Session.InteractionState == SessionInteractionState.PersistenceFailure)
        {
            _shouldFocusInput = false;
            _shouldFocusPrimaryOverlay = true;
            StopTimer();
        }
        else if (Session.InteractionState is SessionInteractionState.IncorrectFeedback or SessionInteractionState.TimeoutFeedback)
        {
            _shouldFocusInput = false;
            _shouldFocusPrimaryOverlay = true;
            if (Session.LastEvaluation?.SubmittedNumericAnswer is decimal submittedAnswer)
            {
                _answerInput = NumericAnswerInputPolicy.Format(submittedAnswer, DecimalSeparator);
                _submittedAnswerDisplay = _answerInput;
            }
            StopTimer();
        }
        else if (Session.InteractionState == SessionInteractionState.TeachingIntervention)
        {
            _shouldFocusInput = false;
            _shouldFocusPrimaryOverlay = true;
            StopTimer();
        }
        else if (Session.InteractionState == SessionInteractionState.SessionCheckIn)
        {
            _shouldFocusInput = false;
            _shouldFocusPrimaryOverlay = true;
            StopTimer();
        }

        SyncPracticeGateCopy();
    }

    public void Dispose()
    {
        Localizer.UiLanguageChanged -= OnLanguageChanged;
        Session.AppForegroundStateChanged -= OnAppForegroundChanged;
        StopTimer();
        Session.PauseItemTiming();
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        if (Session.PracticeGate != PracticeGateState.Running)
        {
            PracticeGateCopyState.Relocalize(
                Localizer.CurrentUiLanguage,
                PracticeGateFallbackTitle);
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnAppForegroundChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (Session.IsAppForeground)
            {
                SyncStateWithSession();
            }
            else
            {
                StopTimer();
                UpdateTimerVisuals(Session.GetCurrentItemElapsed().TotalSeconds);
                SyncPracticeGateCopy();
            }
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsAnswerEntryVisible && _guardedInputRenderVersion != _inputRenderVersion)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "MathFirstUi.attachNumericInputGuard",
                    _inputElement,
                    NumericAnswerInputPolicy.MaximumLength);
                _guardedInputRenderVersion = _inputRenderVersion;
            }
            catch
            {
                // The C# controlled-input policy remains the fallback if JS interop is unavailable.
            }
        }

        if (_shouldFocusInput)
        {
            _shouldFocusInput = false;
            try
            {
                await _inputElement.FocusAsync();
            }
            catch
            {
            }
        }
        else if (_shouldFocusPrimaryOverlay)
        {
            _shouldFocusPrimaryOverlay = false;
            try
            {
                await _primaryOverlayButton.FocusAsync();
            }
            catch
            {
            }
        }
    }

    private async Task HandleAnswerInput(ChangeEventArgs e)
    {
        var proposedValue = e.Value?.ToString();
        if (NumericAnswerInputPolicy.IsValidEdit(proposedValue))
        {
            _answerInput = proposedValue!;
            _validationError = null;
            await TryAutoSubmitAsync();
            return;
        }

        // Recreate the controlled field so rejected keyboard/paste text cannot remain in the DOM.
        _inputRenderVersion++;
        _shouldFocusInput = true;
    }

    private async Task HandleGlobalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is not "Enter" and not "NumpadEnter")
        {
            return;
        }

        if (IsAwaitingAcknowledgement)
        {
            Advance();
        }
        else if (Session.InteractionState == SessionInteractionState.SessionCheckIn)
        {
            KeepGoing();
        }
        else if (Session.InteractionState == SessionInteractionState.PersistenceFailure)
        {
            await RecoverFromPersistenceFailureAsync();
        }
        else if (Session.PracticeGate != PracticeGateState.Running)
        {
            StartOrResumePractice();
        }
        else
        {
            await Submit();
        }
    }

    private async Task HandleKeypadKeyAsync(string key)
    {
        if (!IsAnswerEntryVisible || _isSubmitting)
        {
            return;
        }

        _answerInput = key == "backspace"
            ? NumericAnswerInputPolicy.Backspace(_answerInput)
            : NumericAnswerInputPolicy.Append(_answerInput, key);
        _validationError = null;
        _shouldFocusInput = true;
        if (key != "backspace")
        {
            await TryAutoSubmitAsync();
        }
    }

    private async Task TryAutoSubmitAsync()
    {
        if (IsAnswerEntryVisible &&
            AnswerAutoSubmissionPolicy.ShouldSubmit(_answerInput, Session.CurrentFact.CorrectResult))
        {
            await Submit();
        }
    }

    private void StartTimer()
    {
        StopTimer();
        UpdateTimerVisuals(Session.GetCurrentItemElapsed().TotalSeconds);
        if (!Session.IsTimingActive)
        {
            return;
        }
        _timerCts = new CancellationTokenSource();
        var token = _timerCts.Token;

        _ = Task.Run(async () =>
        {
            using var periodicTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(50));
            while (!token.IsCancellationRequested)
            {
                try
                {
                    if (!await periodicTimer.WaitForNextTickAsync(token))
                    {
                        break;
                    }
                }
                catch (OperationCanceledException)
                {
                    break;
                }

                if (token.IsCancellationRequested)
                {
                    break;
                }

                var elapsed = Session.GetCurrentItemElapsed();
                var deadlineSeconds = Session.CurrentFactDeadlineSeconds;
                if (elapsed.TotalSeconds >= deadlineSeconds)
                {
                    await InvokeAsync(async () =>
                    {
                        if (!token.IsCancellationRequested && Session.IsTimingActive)
                        {
                            UpdateTimerVisuals(deadlineSeconds);
                            await HandleTimeoutAsync();
                        }
                    });
                    break;
                }

                UpdateTimerVisuals(elapsed.TotalSeconds);
                await InvokeAsync(StateHasChanged);
            }
        }, token);
    }

    private void StopTimer()
    {
        if (_timerCts is not null)
        {
            try
            {
                _timerCts.Cancel();
                _timerCts.Dispose();
            }
            catch
            {
            }
            _timerCts = null;
        }
    }

    private void UpdateTimerVisuals(double elapsedSeconds)
    {
        var deadlineSeconds = Session.CurrentFactDeadlineSeconds;
        var remainingSeconds = Math.Max(0.0, deadlineSeconds - elapsedSeconds);
        _remainingSecondsDouble = remainingSeconds;
        _timerFraction = deadlineSeconds > 0 ? Math.Clamp(remainingSeconds / deadlineSeconds, 0.0, 1.0) : 0.0;
        _timerDisplayText = LearningPolicy.FormatTimerDisplay(remainingSeconds, deadlineSeconds);
        var hue = (int)(_timerFraction * 135);
        _timerColor = $"hsl({hue}, 72%, 42%)";
    }

    private async Task Submit()
    {
        if (_isSubmitting || !IsAnswerEntryVisible)
        {
            return;
        }

        if (string.IsNullOrEmpty(_answerInput))
        {
            _validationError = Localizer["Training_EnterNumber"];
            _shouldFocusInput = true;
            return;
        }

        if (NumericAnswerInputPolicy.TryParseSubmission(_answerInput, out var parsedAnswer))
        {
            _isSubmitting = true;
            StopTimer();
            try
            {
                _validationError = null;
                _submittedAnswerDisplay = _answerInput;
                var eval = Session.SubmitAnswer(parsedAnswer);
                var persistence = await Session.CommitCurrentEvaluationAsync();
                var advancedAutomatically = eval.IsCorrect &&
                    persistence.IsSuccess &&
                    Session.AdvanceAfterCorrectAnswer(startTiming: true);

                if (advancedAutomatically)
                {
                    PrepareNextFactUi();
                }
                else
                {
                    _shouldFocusPrimaryOverlay =
                        !eval.IsCorrect ||
                        Session.InteractionState == SessionInteractionState.PersistenceFailure ||
                        Session.InteractionState == SessionInteractionState.TeachingIntervention ||
                        Session.InteractionState == SessionInteractionState.SessionCheckIn;
                }
            }
            finally
            {
                _isSubmitting = false;
            }
        }
        else
        {
            _validationError = Localizer["Training_EnterValidNumber"];
            _shouldFocusInput = true;
        }
    }

    private async Task HandleTimeoutAsync()
    {
        if (_isSubmitting || !IsAnswerEntryVisible)
        {
            return;
        }

        _isSubmitting = true;
        StopTimer();
        try
        {
            _validationError = null;
            Session.RecordTimeout();
            _shouldFocusPrimaryOverlay = true;

            await Session.CommitCurrentEvaluationAsync();
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Advance()
    {
        if (!IsAwaitingAcknowledgement)
        {
            return;
        }

        if (Session.InteractionState == SessionInteractionState.TeachingIntervention)
        {
            Session.AcknowledgeTeachingIntervention(startTiming: true);
        }
        else
        {
            Session.AcknowledgeFeedback(startTiming: true);
        }

        if (Session.InteractionState != SessionInteractionState.SessionCheckIn)
        {
            PrepareNextFactUi();
        }
        else
        {
            _shouldFocusInput = false;
            _shouldFocusPrimaryOverlay = true;
            StopTimer();
        }
    }

    private async Task RecoverFromPersistenceFailureAsync()
    {
        if (_isSubmitting || Session.InteractionState != SessionInteractionState.PersistenceFailure)
        {
            return;
        }

        _isSubmitting = true;
        try
        {
            var recovered = await Session.RecoverFromPersistenceFailureAsync();
            if (recovered)
            {
                if (Session.InteractionState == SessionInteractionState.CorrectFeedback)
                {
                    Session.AdvanceAfterCorrectAnswer(startTiming: true);
                }

                if (Session.InteractionState != SessionInteractionState.SessionCheckIn)
                {
                    PrepareNextFactUi();
                }
                else
                {
                    _shouldFocusInput = false;
                    _shouldFocusPrimaryOverlay = true;
                    StopTimer();
                }
            }
            else
            {
                _shouldFocusPrimaryOverlay = true;
            }
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void PrepareNextFactUi()
    {
        _inputRenderVersion++;
        _answerInput = string.Empty;
        _submittedAnswerDisplay = null;
        _validationError = null;
        SyncPracticeGateCopy();
        _shouldFocusInput = true;
        _shouldFocusPrimaryOverlay = false;
        if (Session.IsTimingActive)
        {
            StartTimer();
        }
    }

    private void PausePractice()
    {
        Session.PausePractice();
        StopTimer();
        _shouldFocusInput = false;
        _shouldFocusPrimaryOverlay = true;
        SyncPracticeGateCopy();
    }

    private void StartOrResumePractice()
    {
        Session.StartOrResumePractice();
        SyncPracticeGateCopy();
        _shouldFocusPrimaryOverlay = false;
        _shouldFocusInput = true;
        if (Session.IsTimingActive)
        {
            StartTimer();
        }
    }

    private void KeepGoing()
    {
        Session.ContinuePractice(startTiming: true);
        PrepareNextFactUi();
    }

    private void TakeBreak()
    {
        Session.TakeBreak();
        StopTimer();
        _shouldFocusInput = false;
        _shouldFocusPrimaryOverlay = true;
        SyncPracticeGateCopy();
    }

    private string GetCheckInLatencyDisplay(long? latencyMs)
    {
        if (!latencyMs.HasValue || latencyMs.Value <= 0)
        {
            return Localizer["Training_Unavailable"];
        }

        if (latencyMs.Value < 1000)
        {
            return $"{latencyMs.Value} ms";
        }

        var seconds = latencyMs.Value / 1000.0;
        return $"{seconds.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)} s";
    }

    private bool IsAwaitingAcknowledgement =>
        Session.InteractionState is SessionInteractionState.IncorrectFeedback
            or SessionInteractionState.TimeoutFeedback
            or SessionInteractionState.TeachingIntervention;

    private bool IsAnswerEntryVisible =>
        Session.IsInitialized &&
        Session.CurrentFact is not null &&
        Session.PracticeGate == PracticeGateState.Running &&
        Session.InteractionState == SessionInteractionState.AwaitingAnswer;

    private bool CanPausePractice => IsAnswerEntryVisible && !_isSubmitting;

    private IReadOnlyList<OperationProgressDiagnostics> OperationProgress
    {
        get
        {
            var learnerStateGeneration = Session.LearnerStateGenerationRevision;
            var practicePosition = Session.Progression.PracticePosition;
            if (_operationProgressLearnerStateGeneration != learnerStateGeneration ||
                _operationProgressPracticePosition != practicePosition)
            {
                _operationProgress = LearningProgressDiagnostics.Create(Session.Progression, _curriculum).Operations;
                _operationProgressLearnerStateGeneration = learnerStateGeneration;
                _operationProgressPracticePosition = practicePosition;
            }

            return _operationProgress;
        }
    }

    private static string GetOperationSymbol(ArithmeticOperation operation) => operation switch
    {
        ArithmeticOperation.Addition => "+",
        ArithmeticOperation.Subtraction => "−",
        ArithmeticOperation.Multiplication => "×",
        ArithmeticOperation.Division => "÷",
        _ => "—"
    };

    private void SyncPracticeGateCopy()
    {
        var gate = Session.PracticeGate;
        if (gate == PracticeGateState.Running)
        {
            PracticeGateCopyState.Clear();
            return;
        }

        var context = PracticeCopyContext.FromSession(
            Session,
            Localizer.CurrentUiLanguage,
            DateTimeOffset.UtcNow);
        PracticeGateCopyState.Synchronize(
            new PracticeGatePresentationIdentity(
                Session.LearnerStateGenerationRevision,
                Session.PracticeGateActivationRevision),
            context,
            PracticeGateFallbackTitle);
    }

    private string PracticeGateTitle =>
        PracticeGateCopyState.Current?.LocalizedText ?? PracticeGateFallbackTitle;

    private string PracticeGateFallbackTitle =>
        Session.PracticeGate == PracticeGateState.InitialReadyGate
            ? Localizer["Training_ReadyTitle"]
            : Localizer["Training_PausedTitle"];

    private string PracticeGateAction => Session.PracticeGate == PracticeGateState.InitialReadyGate
        ? Localizer["Training_Start"]
        : Localizer["Training_ResumePractice"];

    private string DecimalSeparator => Localizer.CurrentUiLanguage == "en" ? "." : ",";

    // On Android the custom keypad is the primary input mechanism.
    // Setting inputmode="none" instructs the browser WebView not to
    // show the native Android soft keyboard when the answer field gains
    // focus — the custom keypad remains visible and fully operable.
    // On all other platforms (Windows) "decimal" signals a numeric
    // decimal entry surface to the OS / browser.
#if ANDROID
    private static string AnswerInputMode => "none";
    private static string AnswerVirtualKeyboardPolicy => "manual";
#else
    private static string AnswerInputMode => "decimal";
    private static string AnswerVirtualKeyboardPolicy => "auto";
#endif

    private string SubmittedAnswerDisplay =>
        _submittedAnswerDisplay ??
        (Session.LastEvaluation?.SubmittedNumericAnswer is decimal submittedAnswer
            ? NumericAnswerInputPolicy.Format(submittedAnswer, DecimalSeparator)
            : string.Empty);
}
