@page "/not-found"
@layout MainLayout
@implements IDisposable
@using MathFirst.Application
@using MathFirst.Application.Navigation
@inject ILocalizationService Localizer
@inject NavigationManager Navigation
@inject IAppBackNavigationCoordinator BackCoordinator

<div class="settings-page notfound-page">
    <div class="settings-container">
        <section class="settings-card notfound-card" role="region" aria-labelledby="notfound-title">
            <h2 id="notfound-title" class="settings-section-title">@Localizer["NotFound_Title"]</h2>
            <p class="setting-help">@Localizer["NotFound_Description"]</p>
        </section>
    </div>
</div>

@code {
    private IDisposable? _backRegistration;

    protected override void OnInitialized()
    {
        _backRegistration = BackCoordinator.RegisterHandler(HandleBack);
    }

    public void Dispose()
    {
        _backRegistration?.Dispose();
    }

    private bool HandleBack()
    {
        Navigation.NavigateTo("/");
        return true;
    }
}
