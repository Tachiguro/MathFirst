@page "/settings"
@implements IDisposable
@using MathFirst.App.Services
@using MathFirst.Application
@using MathFirst.Application.Lifecycle
@using MathFirst.Application.Navigation
@using MathFirst.Application.Practice
@using MathFirst.Application.Telemetry
@using MathFirst.Domain
@using MathFirst.Application.Persistence
@using MathFirst.Domain.Curriculum
@using MathFirst.Domain.CyberDefense
@inject ILocalizationService Localizer
@inject IThemeService ThemeService
@inject AppBuildInfo BuildInfo
@inject IPreferenceStore PreferenceStore
@inject ICyberDefenseModePreferences CyberDefensePreferences
@inject ICyberDefenseTutorialReplayRequests TutorialReplayRequests
@inject TrainingSession Session
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IAppBackNavigationCoordinator BackCoordinator
@inject IHapticFeedbackService HapticService
@inject IAppResetCoordinator ResetCoordinator
@using Microsoft.Extensions.DependencyInjection
@inject IServiceScopeFactory ScopeFactory

<div class="settings-page">
    <header class="settings-header">
        <h1 class="settings-title">@Localizer["Settings_Title"]</h1>
        <button type="button"
                class="button button-secondary"
                @onclick="NavigateBack">
            @Localizer["Common_Back"]
        </button>
    </header>

    <div class="settings-container">
        <!-- 1. UI LANGUAGE -->
        <section class="settings-card" aria-labelledby="settings-language-title">
            <h2 id="settings-language-title" class="settings-section-title">
                <label for="ui-language-select">@Localizer["Settings_UILanguage"]</label>
            </h2>
            <select id="ui-language-select"
                    @bind="_selectedLanguage"
                    @bind:after="HandleLanguageChanged">
                <option value="system">@Localizer["Settings_UILanguageSystem"]</option>
                <option value="en">@Localizer["Settings_English"]</option>
                <option value="de">@Localizer["Settings_German"]</option>
                <option value="ru">@Localizer["Settings_Russian"]</option>
            </select>
            @if (!string.IsNullOrEmpty(_languageMessage))
            {
                <p class="setting-feedback setting-feedback-success" role="status">
                    @_languageMessage
                </p>
            }
        </section>

        <!-- 2. APPEARANCE -->
        <section class="settings-card">
            <h2 class="settings-section-title">@Localizer["Settings_Appearance"]</h2>
            <div class="choice-grid choice-grid-three">
                <button type="button"
                        class="choice-button @(ThemeService.Preference == ThemePreference.System ? "active" : null)"
                        aria-pressed="@(ThemeService.Preference == ThemePreference.System)"
                        @onclick="() => SelectTheme(ThemePreference.System)">
                    @Localizer["Settings_AppearanceSystem"]
                </button>
                <button type="button"
                        class="choice-button @(ThemeService.Preference == ThemePreference.Light ? "active" : null)"
                        aria-pressed="@(ThemeService.Preference == ThemePreference.Light)"
                        @onclick="() => SelectTheme(ThemePreference.Light)">
                    @Localizer["Settings_AppearanceLight"]
                </button>
                <button type="button"
                        class="choice-button @(ThemeService.Preference == ThemePreference.Dark ? "active" : null)"
                        aria-pressed="@(ThemeService.Preference == ThemePreference.Dark)"
                        @onclick="() => SelectTheme(ThemePreference.Dark)">
                    @Localizer["Settings_AppearanceDark"]
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_appearanceMessage))
            {
                <p class="setting-feedback setting-feedback-success" role="status">
                    @_appearanceMessage
                </p>
            }
        </section>

        <!-- 3. TRAINING MODE (CYBER DEFENSE / CALM MODE) -->
        <section class="settings-card cyber-mode-settings-card" aria-labelledby="settings-cyber-mode-title">
            <h2 id="settings-cyber-mode-title" class="settings-section-title">@Localizer["Settings_CyberDefenseModeTitle"]</h2>
            <p class="setting-help">@Localizer["Settings_CyberDefenseModeHelp"]</p>
            <div class="choice-grid choice-grid-two">
                <button type="button"
                        class="choice-button @(CyberDefensePreferences.GetCyberDefenseEnabled() ? "active" : null)"
                        aria-pressed="@CyberDefensePreferences.GetCyberDefenseEnabled()"
                        @onclick="() => SetCyberDefenseMode(true)">
                    @Localizer["CyberDefense_Mode_CyberDefense"]
                </button>
                <button type="button"
                        class="choice-button @(!CyberDefensePreferences.GetCyberDefenseEnabled() ? "active" : null)"
                        aria-pressed="@(!CyberDefensePreferences.GetCyberDefenseEnabled())"
                        @onclick="() => SetCyberDefenseMode(false)">
                    @Localizer["CyberDefense_Mode_Calm"]
                </button>
            </div>
            @if (CyberDefensePreferences.GetCyberDefenseEnabled())
            {
                <div class="settings-action-row cyber-replay-action-row" style="margin-top: var(--space-3, 0.75rem);">
                    <button type="button"
                            class="button button-secondary replay-tutorial-btn"
                            @onclick="ReplayTutorial"
                            aria-label='@Localizer["Settings_CyberDefenseReplayTutorial"]'>
                        @Localizer["Settings_CyberDefenseReplayTutorial"]
                    </button>
                </div>

                <div class="settings-subsection cyber-achievements-subsection" aria-labelledby="cyber-achievements-title">
                    <h3 id="cyber-achievements-title" class="settings-subsection-title">@Localizer["Settings_Achievements_Title"]</h3>
                    <p class="setting-help">@Localizer["Settings_Achievements_Desc"]</p>

                    @if (_achievementState == AchievementLoadState.Loading || _achievementState == AchievementLoadState.NotLoaded)
                    {
                        <div class="achievement-loading-panel" role="status">
                            <span class="achievement-loading-text">@Localizer["Training_Loading"]</span>
                        </div>
                    }
                    else if (_achievementState == AchievementLoadState.Failed)
                    {
                        <div class="achievement-error-panel" role="alert">
                            <p class="achievement-error-text">@Localizer["Settings_Achievements_LoadFailed"]</p>
                            <button type="button"
                                    class="button button-secondary achievement-retry-btn"
                                    @onclick="RetryLoadAchievementsAsync"
                                    aria-label='@Localizer["Training_Retry"]'>
                                @Localizer["Training_Retry"]
                            </button>
                        </div>
                    }
                    else if (_achievementState == AchievementLoadState.Loaded && _unlockedAchievements != null)
                    {
                        <ul class="cyber-achievements-list" role="list">
                            @foreach (var achievement in KnownAchievements)
                            {
                                var isUnlocked = _unlockedAchievements.Contains(achievement.Id);
                                var statusText = isUnlocked
                                    ? Localizer["Settings_Achievements_Unlocked"]
                                    : Localizer["Settings_Achievements_Locked"];
                                <li class="achievement-item @(isUnlocked ? "achievement-unlocked" : "achievement-locked")"
                                    aria-label="@Localizer[achievement.TitleKey]">
                                    <div class="achievement-info">
                                        <span class="achievement-title">@Localizer[achievement.TitleKey]</span>
                                        <span class="achievement-desc">@Localizer[achievement.DescKey]</span>
                                    </div>
                                    <span class="achievement-status-badge @(isUnlocked ? "badge-unlocked" : "badge-locked")"
                                          role="status"
                                          aria-label="@statusText">
                                        @statusText
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(_cyberDefenseMessage))
            {
                <p class="setting-feedback setting-feedback-success" role="status">
                    @_cyberDefenseMessage
                </p>
            }
        </section>

        <!-- 4. PRACTICE -->
        <section class="settings-card practice-settings-card" aria-labelledby="settings-practice-title">
            <h2 id="settings-practice-title" class="settings-section-title">@Localizer["Settings_PracticeSectionTitle"]</h2>

            <div class="settings-subsection">
                <h3 class="settings-subsection-title">@Localizer["Settings_OperationsTitle"]</h3>
                <p class="setting-help">@Localizer["Settings_OperationsHelp"]</p>
                <div class="choice-grid choice-grid-two">
                    @foreach (var operation in PracticeOperationPreferencePolicy.AllOperations)
                    {
                        var isUnlocked = CurriculumUnlockPolicy.GetUnlockedOperations(Session.Progression.CurriculumStage).Contains(operation);
                        <div class="choice-button read-only @(isUnlocked ? "active" : "disabled")"
                             aria-disabled="true">
                            <span class="operation-name">@Localizer[$"Operation_{operation}"]</span>
                            <span class="operation-status-badge @(isUnlocked ? "badge-unlocked" : "badge-locked")">
                                @(isUnlocked ? Localizer["Settings_OperationUnlocked"] : Localizer["Settings_OperationLocked"])
                            </span>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- 4. NUMBER KEYPAD -->
        <section class="settings-card keypad-settings-card" aria-labelledby="settings-keypad-title">
            <h2 id="settings-keypad-title" class="settings-section-title">@Localizer["Keypad_NumberKeypad"]</h2>
            <p class="setting-help">@Localizer["Keypad_Explanation"]</p>
            <div class="keypad-choice-grid">
                <button type="button"
                        class="keypad-choice-card @(_selectedKeypadLayout == NumericKeypadLayout.Numpad ? "active" : null)"
                        aria-pressed="@(_selectedKeypadLayout == NumericKeypadLayout.Numpad)"
                        @onclick="() => SelectKeypadLayout(NumericKeypadLayout.Numpad)">
                    <span class="keypad-choice-title">@Localizer["Keypad_Numpad"]</span>
                    <MathFirst.App.Components.Shared.NumericKeypadPreview Layout="NumericKeypadLayout.Numpad"
                                                                             DecimalSeparator="@DecimalSeparator" />
                </button>
                <button type="button"
                        class="keypad-choice-card @(_selectedKeypadLayout == NumericKeypadLayout.Phone ? "active" : null)"
                        aria-pressed="@(_selectedKeypadLayout == NumericKeypadLayout.Phone)"
                        @onclick="() => SelectKeypadLayout(NumericKeypadLayout.Phone)">
                    <span class="keypad-choice-title">@Localizer["Keypad_Phone"]</span>
                    <MathFirst.App.Components.Shared.NumericKeypadPreview Layout="NumericKeypadLayout.Phone"
                                                                             DecimalSeparator="@DecimalSeparator" />
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_keypadMessage))
            {
                <p class="setting-feedback setting-feedback-success" role="status">@_keypadMessage</p>
            }
        </section>



        <!-- 5. HAPTIC FEEDBACK -->
        <section class="settings-card haptic-settings-card" aria-labelledby="settings-haptic-title">
            <h2 id="settings-haptic-title" class="settings-section-title">@Localizer["Settings_HapticFeedbackTitle"]</h2>
            <p class="setting-help">@Localizer["Settings_HapticFeedbackHelp"]</p>
            <div class="choice-grid choice-grid-two">
                <button type="button"
                        class="choice-button @(_hapticFeedbackEnabled ? "active" : null)"
                        aria-pressed="@_hapticFeedbackEnabled"
                        @onclick="() => SetHapticFeedback(true)">
                    @Localizer["Common_On"]
                </button>
                <button type="button"
                        class="choice-button @(!_hapticFeedbackEnabled ? "active" : null)"
                        aria-pressed="@(!_hapticFeedbackEnabled)"
                        @onclick="() => SetHapticFeedback(false)">
                    @Localizer["Common_Off"]
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_hapticMessage))
            {
                <p class="setting-feedback setting-feedback-success" role="status">@_hapticMessage</p>
            }
        </section>

        <!-- 6. PRIVACY -->
        <section class="settings-card" aria-labelledby="settings-privacy-title">
            <div class="settings-action-header">
                <h2 id="settings-privacy-title" class="settings-section-title">@Localizer["Settings_Privacy"]</h2>
                <a class="button button-secondary" href="privacy">
                    @Localizer["Settings_Privacy_Action"]
                </a>
            </div>
            <p class="setting-help">@Localizer["Settings_Privacy_Desc"]</p>
        </section>

        <!-- 7. RESET LEARNING PROGRESS -->
        <section class="settings-card learning-reset-card">
            <div class="settings-action-header">
                <h2 class="settings-section-title">@Localizer["Reset_LearningProgress_Title"]</h2>
                @if (_activeConfirmAction != ConfirmAction.ResetLearning)
                {
                    <button type="button" class="button button-danger" @onclick="() => PromptConfirm(ConfirmAction.ResetLearning)">
                        @Localizer["Reset_LearningProgress_Title"]
                    </button>
                }
            </div>
            <p class="setting-help">@Localizer["Reset_LearningProgress_Desc"]</p>
            @if (_activeConfirmAction == ConfirmAction.ResetLearning)
            {
                <div id="reset-learning-confirmation"
                     @ref="_confirmationPanel"
                     class="settings-confirm-panel destructive-confirmation"
                     role="group"
                     tabindex="-1"
                     aria-label="@Localizer["Reset_LearningProgress_Confirm"]">
                    <p>@Localizer["Reset_LearningProgress_Confirm"]</p>
                    <div class="settings-confirm-buttons">
                        <button type="button" class="button button-secondary" @onclick="CancelConfirm">@Localizer["Common_Cancel"]</button>
                        <button type="button" class="button button-danger" @onclick="ExecuteResetLearning">@Localizer["Common_Confirm"]</button>
                    </div>
                </div>
            }
        </section>

        <!-- 8. RESTORE DEFAULT SETTINGS -->
        <section class="settings-card restore-defaults-card">
            <div class="settings-action-header">
                <h2 class="settings-section-title">@Localizer["Reset_UiPreferences_Title"]</h2>
                @if (_activeConfirmAction != ConfirmAction.ResetUi)
                {
                    <button type="button" class="button button-secondary" @onclick="() => PromptConfirm(ConfirmAction.ResetUi)">
                        @Localizer["Reset_UiPreferences_Title"]
                    </button>
                }
            </div>
            <p class="setting-help">@Localizer["Reset_UiPreferences_Desc"]</p>
            @if (_activeConfirmAction == ConfirmAction.ResetUi)
            {
                <div id="restore-defaults-confirmation"
                     @ref="_confirmationPanel"
                     class="settings-confirm-panel restore-defaults-confirmation"
                     role="group"
                     tabindex="-1"
                     aria-label="@Localizer["Reset_UiPreferences_Confirm"]">
                    <p>@Localizer["Reset_UiPreferences_Confirm"]</p>
                    <div class="settings-confirm-buttons">
                        <button type="button" class="button button-secondary" @onclick="CancelConfirm">@Localizer["Common_Cancel"]</button>
                        <button type="button" class="button button-primary" @onclick="ExecuteResetUiPreferences">@Localizer["Reset_UiPreferences_Action"]</button>
                    </div>
                </div>
            }
        </section>

        <!-- 9. FULL LOCAL RESET -->
        <section class="settings-card danger-card">
            <div class="settings-action-header">
                <h2 class="settings-section-title danger-title">@Localizer["Reset_FullLocal_Title"]</h2>
                @if (_activeConfirmAction != ConfirmAction.ResetFull)
                {
                    <button type="button" class="button button-danger" @onclick="() => PromptConfirm(ConfirmAction.ResetFull)">
                        @Localizer["Reset_FullLocal_Title"]
                    </button>
                }
            </div>
            <p class="setting-help">@Localizer["Reset_FullLocal_Desc"]</p>
            @if (_activeConfirmAction == ConfirmAction.ResetFull)
            {
                <div id="full-local-reset-confirmation"
                     @ref="_confirmationPanel"
                     class="settings-confirm-panel destructive-confirmation"
                     role="group"
                     tabindex="-1"
                     aria-label="@Localizer["Reset_FullLocal_Confirm"]">
                    <p>@Localizer["Reset_FullLocal_Confirm"]</p>
                    <div class="settings-confirm-buttons">
                        <button type="button" class="button button-secondary" @onclick="CancelConfirm">@Localizer["Common_Cancel"]</button>
                        <button type="button" class="button button-danger" @onclick="ExecuteFullLocalReset">@Localizer["Reset_FullLocal_Action"]</button>
                    </div>
                </div>
            }
        </section>

        @if (!string.IsNullOrEmpty(_resetFeedbackMessage))
        {
            <p class="setting-feedback setting-feedback-success" role="status">@_resetFeedbackMessage</p>
        }
    </div>

    <footer class="settings-version">
        <p class="settings-version-text">@Localizer["Settings_VersionBuild", BuildInfo.DisplayVersion, BuildInfo.BuildNumber]</p>
        <p class="settings-version-meta">@Localizer["Settings_Build"]: @BuildInfo.BuildClassification &bull; @Localizer["Settings_Source"]: @BuildInfo.ShortSourceCommit</p>
        <TesterDiagnosticsSection />
    </footer>
</div>

@code {
    private enum ConfirmAction { None, ResetLearning, ResetUi, ResetFull }

    private enum AchievementLoadState
    {
        NotLoaded,
        Loading,
        Loaded,
        Failed
    }

    private static readonly (string Id, string TitleKey, string DescKey)[] KnownAchievements =
    [
        (CyberDefenseAchievementIds.Sector10, "Achievement_sector_10_Title", "Achievement_sector_10_Desc"),
        (CyberDefenseAchievementIds.BossSlayer, "Achievement_boss_slayer_Title", "Achievement_boss_slayer_Desc"),
        (CyberDefenseAchievementIds.FirstUpgrade, "Achievement_first_upgrade_Title", "Achievement_first_upgrade_Desc")
    ];

    private CancellationTokenSource? _achievementCts;
    private int _achievementLoadSequence;
    private AchievementLoadState _achievementState = AchievementLoadState.NotLoaded;
    private HashSet<string>? _unlockedAchievements;
    private bool _disposed;

    [Parameter]
    public ICyberDefenseAchievementReader? InjectedAchievementReader { get; set; }

    private ICyberDefenseAchievementReader? AchievementReader =>
        InjectedAchievementReader ?? ResolveAchievementReader();

    private ICyberDefenseAchievementReader? ResolveAchievementReader()
    {
        using var scope = ScopeFactory?.CreateScope();
        var provider = scope?.ServiceProvider;
        return provider is null ? null : (ICyberDefenseAchievementReader?)provider.GetService(typeof(ICyberDefenseAchievementReader));
    }

    private string? _languageMessage;
    private string? _appearanceMessage;
    private string? _cyberDefenseMessage;
    private string? _keypadMessage;
    private string? _hapticMessage;
    private string? _resetFeedbackMessage;
    private string _selectedLanguage = LanguagePreferencePolicy.SystemPreferenceCode;
    private NumericKeypadLayout _selectedKeypadLayout = NumericKeypadLayout.Numpad;
    private bool _hapticFeedbackEnabled = true;
    private ConfirmAction _activeConfirmAction = ConfirmAction.None;
    private ElementReference _confirmationPanel;
    private bool _pendingConfirmationVisibility;
    private IDisposable? _backRegistration;

    protected override async Task OnInitializedAsync()
    {
        Localizer.UiLanguageChanged += OnLanguageChanged;
        ThemeService.ThemeChanged += OnThemeChanged;
        _backRegistration = BackCoordinator.RegisterHandler(HandleBack);
        _selectedLanguage = Localizer.SelectedLanguagePreference;
        _selectedKeypadLayout = PreferenceStore.GetNumericKeypadLayout();
        _hapticFeedbackEnabled = PreferenceStore.GetHapticFeedbackEnabled();

        if (CyberDefensePreferences.GetCyberDefenseEnabled())
        {
            _achievementState = AchievementLoadState.Loading;
        }

        if (!Session.IsInitialized)
        {
            await Session.InitializeAsync(startTiming: false);
        }

        Session.PauseItemTiming();

        if (CyberDefensePreferences.GetCyberDefenseEnabled())
        {
            _ = LoadAchievementsAsync();
        }
    }

    private void CancelAndDisposeAchievementCts()
    {
        var cts = _achievementCts;
        _achievementCts = null;
        if (cts is null)
        {
            return;
        }

        try
        {
            cts.Cancel();
        }
        catch (ObjectDisposedException)
        {
        }
        cts.Dispose();
    }

    public void Dispose()
    {
        _disposed = true;
        CancelAndDisposeAchievementCts();
        _achievementLoadSequence++;
        Localizer.UiLanguageChanged -= OnLanguageChanged;
        ThemeService.ThemeChanged -= OnThemeChanged;
        _backRegistration?.Dispose();
    }

    private bool HandleBack()
    {
        Navigation.NavigateTo("/");
        return true;
    }

    private void ReplayTutorial()
    {
        TutorialReplayRequests.RequestTutorialReplay();
        Navigation.NavigateTo("/");
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/");
    }

    private async Task SafeInvokeStateHasChangedAsync()
    {
        if (_disposed)
        {
            return;
        }

        try
        {
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private void OnLanguageChanged(object? sender, EventArgs e)
    {
        _selectedLanguage = Localizer.SelectedLanguagePreference;
        _ = SafeInvokeStateHasChangedAsync();
    }

    private void OnThemeChanged(object? sender, EventArgs e)
    {
        _ = SafeInvokeStateHasChangedAsync();
    }

    private void HandleLanguageChanged()
    {
        Localizer.ApplyLanguagePreference(_selectedLanguage);
        var displayName = _selectedLanguage switch
        {
            "en" => Localizer["Settings_English"],
            "de" => Localizer["Settings_German"],
            "ru" => Localizer["Settings_Russian"],
            _ => Localizer["Settings_UILanguageSystem"]
        };
        _languageMessage = Localizer["Settings_LanguageChangedTo", displayName];
        _appearanceMessage = null;
        _cyberDefenseMessage = null;
        _keypadMessage = null;
        _hapticMessage = null;
        _resetFeedbackMessage = null;
    }

    private void SelectTheme(ThemePreference theme)
    {
        ThemeService.SetPreference(theme);
        var displayName = theme switch
        {
            ThemePreference.Light => Localizer["Settings_AppearanceLight"],
            ThemePreference.Dark => Localizer["Settings_AppearanceDark"],
            _ => Localizer["Settings_AppearanceSystem"]
        };
        _appearanceMessage = Localizer["Settings_AppearanceChangedTo", displayName];
        _languageMessage = null;
        _cyberDefenseMessage = null;
        _keypadMessage = null;
        _hapticMessage = null;
        _resetFeedbackMessage = null;
    }

    private void SetCyberDefenseMode(bool enabled)
    {
        CyberDefensePreferences.SetCyberDefenseEnabled(enabled);
        var displayName = enabled
            ? Localizer["CyberDefense_Mode_CyberDefense"]
            : Localizer["CyberDefense_Mode_Calm"];
        _cyberDefenseMessage = Localizer["Settings_CyberDefenseModeChangedTo", displayName];
        _languageMessage = null;
        _appearanceMessage = null;
        _keypadMessage = null;
        _hapticMessage = null;
        _resetFeedbackMessage = null;

        if (enabled)
        {
            _ = LoadAchievementsAsync();
        }
        else
        {
            CancelAndDisposeAchievementCts();
            _achievementLoadSequence++;
            _achievementState = AchievementLoadState.NotLoaded;
            _ = SafeInvokeStateHasChangedAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pendingConfirmationVisibility)
        {
            return;
        }

        _pendingConfirmationVisibility = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("MathFirstUi.focusAndScrollIntoView", _confirmationPanel);
        }
        catch
        {
            // The confirmation remains visible and keyboard-accessible if JS interop is unavailable.
        }
    }

    private void SelectKeypadLayout(NumericKeypadLayout layout)
    {
        _selectedKeypadLayout = NumericKeypadLayoutPolicy.Normalize((int)layout);
        PreferenceStore.SetNumericKeypadLayout(_selectedKeypadLayout);
        var displayName = _selectedKeypadLayout == NumericKeypadLayout.Phone
            ? Localizer["Keypad_Phone"]
            : Localizer["Keypad_Numpad"];
        _keypadMessage = Localizer["Keypad_ChangedTo", displayName];
        _languageMessage = null;
        _appearanceMessage = null;
        _cyberDefenseMessage = null;
        _hapticMessage = null;
        _resetFeedbackMessage = null;
    }

    private void SetHapticFeedback(bool enabled)
    {
        PreferenceStore.SetHapticFeedbackEnabled(enabled);
        _hapticFeedbackEnabled = PreferenceStore.GetHapticFeedbackEnabled();
        if (enabled)
        {
            HapticService.PerformCue(HapticFeedbackCue.KeyTap);
        }
        var stateDisplay = enabled ? Localizer["Common_On"] : Localizer["Common_Off"];
        _hapticMessage = Localizer["Settings_HapticFeedbackChangedTo", stateDisplay];
        _languageMessage = null;
        _appearanceMessage = null;
        _cyberDefenseMessage = null;
        _keypadMessage = null;
        _resetFeedbackMessage = null;
    }

    private void PromptConfirm(ConfirmAction action)
    {
        _activeConfirmAction = action;
        _pendingConfirmationVisibility = true;
        _resetFeedbackMessage = null;
    }

    private void CancelConfirm()
    {
        _activeConfirmAction = ConfirmAction.None;
    }

    private async Task ExecuteResetLearning()
    {
        Session.PauseItemTiming();
        await Session.ResetLearningProgressAsync(startTiming: false);
        _activeConfirmAction = ConfirmAction.None;
        _resetFeedbackMessage = Localizer["Reset_LearningProgress_Success"];
        _languageMessage = null;
        _appearanceMessage = null;
        _cyberDefenseMessage = null;
        _keypadMessage = null;
        _hapticMessage = null;
    }

    private void ExecuteResetUiPreferences()
    {
        Session.PauseItemTiming();
        PreferenceStore.SetLanguagePreference(LanguagePreferencePolicy.SystemPreferenceCode);
        PreferenceStore.SetThemePreference(ThemePreference.System);
        PreferenceStore.SetNumericKeypadLayout(NumericKeypadLayout.Numpad);
        PreferenceStore.SetHapticFeedbackEnabled(true);
        PreferenceStore.ResetPracticePreferences();

        ThemeService.ResetPreference();
        Localizer.ApplyLanguagePreference("system");

        _activeConfirmAction = ConfirmAction.None;
        _resetFeedbackMessage = Localizer["Reset_UiPreferences_Success"];
        _languageMessage = null;
        _appearanceMessage = null;
        _cyberDefenseMessage = null;
        _keypadMessage = null;
        _hapticMessage = null;

        Navigation.NavigateTo("/", replace: true);
    }

    private async Task ExecuteFullLocalReset()
    {
        CancelAndDisposeAchievementCts();
        _achievementLoadSequence++;
        _unlockedAchievements = null;
        _achievementState = AchievementLoadState.NotLoaded;

        await ResetCoordinator.ExecuteFullResetAsync();

        ThemeService.ResetPreference();
        Localizer.ApplyLanguagePreference("system");

        _activeConfirmAction = ConfirmAction.None;
        Navigation.NavigateTo("/", replace: true);
    }


    private async Task LoadAchievementsAsync()
    {
        if (_disposed || !CyberDefensePreferences.GetCyberDefenseEnabled())
        {
            return;
        }

        CancelAndDisposeAchievementCts();

        var cts = new CancellationTokenSource();
        _achievementCts = cts;
        var token = cts.Token;
        var sequence = ++_achievementLoadSequence;

        _achievementState = AchievementLoadState.Loading;
        await SafeInvokeStateHasChangedAsync();

        try
        {
            if (AchievementReader is null)
            {
                throw new InvalidOperationException("Achievement reader is not configured.");
            }

            var records = await AchievementReader.GetUnlockedAchievementsAsync(token);

            if (_disposed || token.IsCancellationRequested || sequence != _achievementLoadSequence)
            {
                return;
            }

            var unlocked = new HashSet<string>(StringComparer.Ordinal);
            foreach (var record in records)
            {
                if (record is null ||
                    !CyberDefenseAchievementIds.IsKnown(record.AchievementId) ||
                    !unlocked.Add(record.AchievementId))
                {
                    throw new InvalidOperationException("Achievement record validation failed.");
                }
            }

            _unlockedAchievements = unlocked;
            _achievementState = AchievementLoadState.Loaded;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception)
        {
            if (_disposed || token.IsCancellationRequested || sequence != _achievementLoadSequence)
            {
                return;
            }

            _unlockedAchievements = null;
            _achievementState = AchievementLoadState.Failed;
        }

        if (_disposed || token.IsCancellationRequested || sequence != _achievementLoadSequence)
        {
            return;
        }

        await SafeInvokeStateHasChangedAsync();
    }

    private Task RetryLoadAchievementsAsync()
    {
        return LoadAchievementsAsync();
    }

    private string DecimalSeparator => Localizer.CurrentUiLanguage == "en" ? "." : ",";
}
