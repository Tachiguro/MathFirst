@using MathFirst.Application
@using MathFirst.Application.Practice
@using MathFirst.Domain
@implements IDisposable

<section class="practice-overlay teaching-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="teaching-dialog-title">
    <div class="practice-overlay-content">
        <h2 id="teaching-dialog-title">@Localizer["Training_TeachingTitle"]</h2>
        <p class="teaching-explanation">@Localizer["Training_TeachingExplanation"]</p>
        <p class="teaching-equation" aria-label="@Session.CurrentFact?.EquationText">
            <span>@Session.CurrentFact?.LeftOperand</span>
            <span>@Session.CurrentFact?.DisplaySymbol</span>
            <span>@Session.CurrentFact?.RightOperand</span>
            <span>=</span>
            <span>@Session.CurrentFact?.CorrectResult</span>
        </p>
        <button type="button"
                @ref="_primaryButton"
                class="button button-primary practice-overlay-action teaching-continue-button"
                disabled="@(!_isUnlocked)"
                aria-disabled="@(!_isUnlocked)"
                @onclick="HandleContinueClick">
            @ButtonText
        </button>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public TrainingSession Session { get; set; } = default!;
    [Parameter, EditorRequired] public ILocalizationService Localizer { get; set; } = default!;
    [Parameter] public EventCallback OnAcknowledge { get; set; }

    private ElementReference _primaryButton;
    private TeachingLockTracker _lockTracker = new();
    private CancellationTokenSource? _timerCts;
    private bool _isUnlocked;
    private int _remainingSeconds = 3;
    private bool _isDisposed;
    private long _lastFactRevision = -1;

    public bool IsUnlocked => _isUnlocked;

    protected override void OnInitialized()
    {
        Session.AppForegroundStateChanged += OnAppForegroundChanged;
        StartTeachingLock();
    }

    protected override void OnParametersSet()
    {
        if (Session.FactInstanceRevision != _lastFactRevision)
        {
            _lastFactRevision = Session.FactInstanceRevision;
            StartTeachingLock();
        }
    }

    private void StartTeachingLock()
    {
        StopTimer();
        if (_isDisposed)
        {
            return;
        }

        _isUnlocked = false;
        _lockTracker = new TeachingLockTracker();
        _lockTracker.SetForeground(Session.IsAppForeground);
        _lockTracker.Activate();
        _remainingSeconds = _lockTracker.RemainingSecondsCeiling;

        if (_remainingSeconds <= 0)
        {
            _isUnlocked = true;
            return;
        }

        _timerCts = new CancellationTokenSource();
        var token = _timerCts.Token;

        _ = Task.Run(async () =>
        {
            using var periodicTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
            while (!token.IsCancellationRequested && !_isDisposed)
            {
                try
                {
                    if (!await periodicTimer.WaitForNextTickAsync(token))
                    {
                        break;
                    }
                }
                catch (OperationCanceledException)
                {
                    break;
                }

                if (token.IsCancellationRequested || _isDisposed)
                {
                    break;
                }

                var remaining = _lockTracker.RemainingSecondsCeiling;
                var unlocked = _lockTracker.IsUnlocked;

                await InvokeAsync(async () =>
                {
                    if (token.IsCancellationRequested || _isDisposed)
                    {
                        return;
                    }

                    _remainingSeconds = remaining;
                    if (unlocked && !_isUnlocked)
                    {
                        _isUnlocked = true;
                        StopTimer();
                        StateHasChanged();
                        try
                        {
                            await _primaryButton.FocusAsync();
                        }
                        catch
                        {
                        }
                    }
                    else
                    {
                        StateHasChanged();
                    }
                });

                if (unlocked)
                {
                    break;
                }
            }
        }, token);
    }

    private void StopTimer()
    {
        if (_timerCts is not null)
        {
            try
            {
                _timerCts.Cancel();
                _timerCts.Dispose();
            }
            catch
            {
            }
            _timerCts = null;
        }
    }

    private async Task HandleContinueClick()
    {
        if (!_isUnlocked || _isDisposed)
        {
            return;
        }

        if (OnAcknowledge.HasDelegate)
        {
            await OnAcknowledge.InvokeAsync();
        }
    }

    private void OnAppForegroundChanged(object? sender, EventArgs e)
    {
        _lockTracker.SetForeground(Session.IsAppForeground);
    }

    private string ButtonText => _isUnlocked
        ? $"{Localizer["Common_Continue"]} (Enter)"
        : Localizer["Training_TeachingContinueLocked", _remainingSeconds];

    public void Dispose()
    {
        _isDisposed = true;
        Session.AppForegroundStateChanged -= OnAppForegroundChanged;
        StopTimer();
        _lockTracker.Deactivate();
    }
}
